{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://blazn.dev/contracts/harness.schema.json",
    "title": "Blazn Harness definition, version, profile and capabilities",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "definition",
        "version",
        "profile"
    ],
    "properties": {
        "definition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schemaVersion",
                "id",
                "kind",
                "publisher",
                "status",
                "supportedPlatforms",
                "securityPolicy",
                "resourceVersion"
            ],
            "properties": {
                "schemaVersion": {
                    "const": "blazn.dev/harness-definition/v1alpha1"
                },
                "id": {
                    "$ref": "#/$defs/id"
                },
                "kind": {
                    "enum": [
                        "hermes",
                        "codex-cli",
                        "claude-code",
                        "generic-cli"
                    ]
                },
                "publisher": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "status": {
                    "enum": [
                        "approved",
                        "deprecated",
                        "prohibited"
                    ]
                },
                "supportedPlatforms": {
                    "$ref": "#/$defs/platforms"
                },
                "securityPolicy": {
                    "const": "poc-harness-restricted-v1"
                },
                "resourceVersion": {
                    "type": "integer",
                    "minimum": 1
                }
            }
        },
        "version": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schemaVersion",
                "id",
                "definitionId",
                "version",
                "digest",
                "protocolVersion",
                "implementation",
                "executable",
                "inputMode",
                "parserVersion",
                "capabilities",
                "supportedPlatforms",
                "credentialCapabilities",
                "compatibility",
                "provenance"
            ],
            "properties": {
                "schemaVersion": {
                    "const": "blazn.dev/harness-version/v1alpha1"
                },
                "id": {
                    "$ref": "#/$defs/id"
                },
                "definitionId": {
                    "$ref": "#/$defs/id"
                },
                "version": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                },
                "digest": {
                    "$ref": "#/$defs/digest"
                },
                "protocolVersion": {
                    "const": "blazn.dev/harness-adapter/v1alpha1"
                },
                "implementation": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "kind",
                        "digest"
                    ],
                    "properties": {
                        "kind": {
                            "enum": [
                                "package",
                                "image"
                            ]
                        },
                        "digest": {
                            "oneOf": [
                                {
                                    "$ref": "#/$defs/digest"
                                },
                                {
                                    "type": "string",
                                    "pattern": "^.+@sha256:[0-9a-f]{64}$",
                                    "maxLength": 640
                                }
                            ]
                        }
                    }
                },
                "executable": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "identity",
                        "path",
                        "fixedArgv",
                        "environmentAllowlist",
                        "termination"
                    ],
                    "properties": {
                        "identity": {
                            "enum": [
                                "blazn-hermes-adapter",
                                "blazn-codex-adapter",
                                "blazn-claude-adapter",
                                "blazn-generic-adapter"
                            ]
                        },
                        "path": {
                            "type": "string",
                            "pattern": "^/[A-Za-z0-9._/-]+$",
                            "maxLength": 512
                        },
                        "fixedArgv": {
                            "type": "array",
                            "maxItems": 32,
                            "items": {
                                "type": "string",
                                "maxLength": 1024
                            }
                        },
                        "environmentAllowlist": {
                            "type": "array",
                            "maxItems": 32,
                            "uniqueItems": true,
                            "items": {
                                "type": "string",
                                "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
                            }
                        },
                        "termination": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "gracefulSignal",
                                "graceSeconds",
                                "killProcessTree"
                            ],
                            "properties": {
                                "gracefulSignal": {
                                    "enum": [
                                        "SIGINT",
                                        "SIGTERM"
                                    ]
                                },
                                "graceSeconds": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 60
                                },
                                "killProcessTree": {
                                    "const": true
                                }
                            }
                        }
                    }
                },
                "inputMode": {
                    "enum": [
                        "stdin-jsonl",
                        "file-json",
                        "native-session"
                    ]
                },
                "parserVersion": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
                },
                "capabilities": {
                    "$ref": "#/$defs/capabilities"
                },
                "supportedPlatforms": {
                    "$ref": "#/$defs/platforms"
                },
                "credentialCapabilities": {
                    "type": "array",
                    "maxItems": 8,
                    "uniqueItems": true,
                    "items": {
                        "enum": [
                            "model.openai",
                            "model.anthropic",
                            "model.proxy",
                            "repository.read",
                            "tool.mcp"
                        ]
                    }
                },
                "compatibility": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "workerProtocol",
                        "sandboxControl",
                        "proxyProtocols"
                    ],
                    "properties": {
                        "workerProtocol": {
                            "const": "blazn.dev/harness-worker/v1alpha1"
                        },
                        "sandboxControl": {
                            "const": "agents.x-k8s.io/v1beta1"
                        },
                        "proxyProtocols": {
                            "type": "array",
                            "maxItems": 3,
                            "uniqueItems": true,
                            "items": {
                                "enum": [
                                    "openai-responses",
                                    "openai-chat",
                                    "anthropic-messages"
                                ]
                            }
                        }
                    }
                },
                "provenance": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "repository",
                        "commit",
                        "artifactDigest",
                        "reviewId"
                    ],
                    "properties": {
                        "repository": {
                            "type": "string",
                            "format": "uri",
                            "pattern": "^https://[^@?#]+$"
                        },
                        "commit": {
                            "type": "string",
                            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                        },
                        "artifactDigest": {
                            "$ref": "#/$defs/digest"
                        },
                        "reviewId": {
                            "$ref": "#/$defs/id"
                        }
                    }
                }
            }
        },
        "profile": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schemaVersion",
                "id",
                "workspaceId",
                "name",
                "harnessVersionId",
                "model",
                "credentials",
                "tools",
                "overrides",
                "policy",
                "status",
                "directProviderAuthorization",
                "digest",
                "resourceVersion"
            ],
            "properties": {
                "schemaVersion": {
                    "const": "blazn.dev/harness-profile/v1alpha1"
                },
                "id": {
                    "$ref": "#/$defs/id"
                },
                "workspaceId": {
                    "$ref": "#/$defs/id"
                },
                "name": {
                    "$ref": "#/$defs/name"
                },
                "harnessVersionId": {
                    "$ref": "#/$defs/id"
                },
                "model": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "routeId",
                        "routeVersion",
                        "protocol"
                    ],
                    "properties": {
                        "routeId": {
                            "$ref": "#/$defs/id"
                        },
                        "routeVersion": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "protocol": {
                            "enum": [
                                "openai-responses",
                                "openai-chat",
                                "anthropic-messages"
                            ]
                        }
                    }
                },
                "credentials": {
                    "type": "array",
                    "maxItems": 8,
                    "uniqueItems": true,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "capability",
                            "scope",
                            "leaseSeconds"
                        ],
                        "properties": {
                            "capability": {
                                "enum": [
                                    "model.openai",
                                    "model.anthropic",
                                    "model.proxy",
                                    "repository.read",
                                    "tool.mcp"
                                ]
                            },
                            "scope": {
                                "type": "string",
                                "pattern": "^(?:route|repo|tool):[a-z0-9][a-z0-9.:/_-]{0,119}$"
                            },
                            "leaseSeconds": {
                                "type": "integer",
                                "minimum": 60,
                                "maximum": 3600
                            }
                        }
                    }
                },
                "tools": {
                    "type": "array",
                    "maxItems": 32,
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/name"
                    }
                },
                "overrides": {
                    "type": "object",
                    "maxProperties": 16,
                    "propertyNames": {
                        "pattern": "^[a-z][a-z0-9._-]{0,63}$"
                    },
                    "additionalProperties": {
                        "oneOf": [
                            {
                                "type": "string",
                                "maxLength": 512
                            },
                            {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 86400
                            },
                            {
                                "type": "boolean"
                            }
                        ]
                    }
                },
                "policy": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "approval",
                        "network",
                        "filesystem",
                        "maxRunSeconds",
                        "maxFollowUps"
                    ],
                    "properties": {
                        "approval": {
                            "enum": [
                                "deny-unlisted",
                                "prompt"
                            ]
                        },
                        "network": {
                            "const": "profile-bound"
                        },
                        "filesystem": {
                            "const": "sandbox-only"
                        },
                        "maxRunSeconds": {
                            "type": "integer",
                            "minimum": 60,
                            "maximum": 14400
                        },
                        "maxFollowUps": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 100
                        }
                    }
                },
                "status": {
                    "enum": [
                        "approved",
                        "disabled"
                    ]
                },
                "digest": {
                    "$ref": "#/$defs/digest"
                },
                "directProviderAuthorization": {
                    "oneOf": [
                        {"type":"null"},
                        {
                            "type":"object",
                            "additionalProperties":false,
                            "required":["id","workspaceId","profileId","routeId","routeVersion","capability","provider","status"],
                            "properties":{
                                "id":{"$ref":"#/$defs/id"},
                                "workspaceId":{"$ref":"#/$defs/id"},
                                "profileId":{"$ref":"#/$defs/id"},
                                "routeId":{"$ref":"#/$defs/id"},
                                "routeVersion":{"type":"integer","minimum":1},
                                "capability":{"enum":["model.openai","model.anthropic"]},
                                "provider":{"enum":["openai","anthropic"]},
                                "status":{"const":"approved"}
                            }
                        }
                    ]
                },
                "resourceVersion": {
                    "type": "integer",
                    "minimum": 1
                }
            }
        }
    },
    "$defs": {
        "id": {
            "type": "string",
            "format": "uuid"
        },
        "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,95}$"
        },
        "platforms": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
                "enum": [
                    "linux/amd64",
                    "linux/arm64",
                    "darwin/arm64"
                ]
            }
        },
        "capabilities": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
                "enum": [
                    "task.one-shot",
                    "message.follow-up",
                    "conversation.resume",
                    "event.structured",
                    "event.streaming",
                    "tool.native",
                    "tool.mcp",
                    "output.patch",
                    "output.artifact",
                    "checkpoint.recovery",
                    "model.select",
                    "provider.configure",
                    "approval.prompt",
                    "cancel.graceful"
                ]
            }
        }
    },
    "x-blazn-secret-boundary": {
        "forbiddenKeys": [
            "token",
            "password",
            "secret",
            "credential",
            "authorization",
            "apiKey",
            "privateKey",
            "kubeconfig",
            "nodeCredential"
        ],
        "delivery": "run-scoped capability lease only"
    }
}
