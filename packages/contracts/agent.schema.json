{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://blazn.dev/contracts/agent.schema.json",
    "title": "Blazn Agent and immutable AgentVersion",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "agent",
        "version"
    ],
    "properties": {
        "agent": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schemaVersion",
                "id",
                "workspaceId",
                "ownerId",
                "name",
                "tags",
                "status",
                "currentVersionId",
                "version"
            ],
            "properties": {
                "schemaVersion": {
                    "const": "blazn.dev/agent/v1alpha1"
                },
                "id": {
                    "$ref": "#/$defs/id"
                },
                "workspaceId": {
                    "$ref": "#/$defs/id"
                },
                "ownerId": {
                    "$ref": "#/$defs/id"
                },
                "name": {
                    "$ref": "#/$defs/name"
                },
                "tags": {
                    "type": "array",
                    "maxItems": 32,
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/name"
                    }
                },
                "status": {
                    "enum": [
                        "active",
                        "inactive",
                        "archived"
                    ]
                },
                "currentVersionId": {
                    "$ref": "#/$defs/id"
                },
                "version": {
                    "type": "integer",
                    "minimum": 1
                }
            }
        },
        "version": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schemaVersion",
                "id",
                "agentId",
                "workspaceId",
                "version",
                "digest",
                "purpose",
                "instructions",
                "modelPolicy",
                "tools",
                "template",
                "repository",
                "resourceProfile",
                "requiredCapabilities",
                "allowedHarnessProfiles",
                "defaultHarnessProfileId",
                "evaluationId",
                "outputContract",
                "createdBy",
                "createdAt"
            ],
            "properties": {
                "schemaVersion": {
                    "const": "blazn.dev/agent-version/v1alpha1"
                },
                "id": {
                    "$ref": "#/$defs/id"
                },
                "agentId": {
                    "$ref": "#/$defs/id"
                },
                "workspaceId": {
                    "$ref": "#/$defs/id"
                },
                "version": {
                    "type": "integer",
                    "minimum": 1
                },
                "digest": {
                    "$ref": "#/$defs/digest"
                },
                "purpose": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                },
                "instructions": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32768
                },
                "modelPolicy": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "routeId",
                        "routeVersion",
                        "policyId",
                        "policyVersion",
                        "requiredProtocols",
                        "fallback"
                    ],
                    "properties": {
                        "routeId": {
                            "$ref": "#/$defs/id"
                        },
                        "routeVersion": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "policyId": {"$ref":"#/$defs/id"},
                        "policyVersion": {"type":"integer","minimum":1},
                        "requiredProtocols": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 4,
                            "uniqueItems": true,
                            "items": {
                                "enum": [
                                    "openai-responses",
                                    "openai-chat",
                                    "anthropic-messages"
                                ]
                            }
                        },
                        "fallback": {
                            "enum": [
                                "disabled",
                                "one-approved-attempt"
                            ]
                        }
                    }
                },
                "tools": {
                    "type": "array",
                    "maxItems": 32,
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/name"
                    }
                },
                "template": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "versionId",
                        "digest"
                    ],
                    "properties": {
                        "versionId": {
                            "$ref": "#/$defs/id"
                        },
                        "digest": {
                            "$ref": "#/$defs/digest"
                        }
                    }
                },
                "repository": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "url",
                        "commit",
                        "writable",
                        "pushAllowed"
                    ],
                    "properties": {
                        "url": {
                            "type": "string",
                            "format": "uri",
                            "pattern": "^https://[^@?#]+$"
                        },
                        "commit": {
                            "type": "string",
                            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                        },
                        "writable": {
                            "const": true
                        },
                        "pushAllowed": {
                            "const": false
                        }
                    }
                },
                "resourceProfile": {
                    "$ref": "#/$defs/name"
                },
                "requiredCapabilities": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 32,
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/capability"
                    }
                },
                "allowedHarnessProfiles": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 16,
                    "uniqueItems": true,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "id",
                            "digest"
                        ],
                        "properties": {
                            "id": {
                                "$ref": "#/$defs/id"
                            },
                            "digest": {
                                "$ref": "#/$defs/digest"
                            }
                        }
                    }
                },
                "defaultHarnessProfileId": {
                    "$ref": "#/$defs/id"
                },
                "evaluationId": {
                    "$ref": "#/$defs/id"
                },
                "outputContract": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "summary",
                        "patch",
                        "artifacts"
                    ],
                    "properties": {
                        "summary": {
                            "const": true
                        },
                        "patch": {
                            "const": true
                        },
                        "artifacts": {
                            "type": "array",
                            "maxItems": 16,
                            "uniqueItems": true,
                            "items": {
                                "enum": [
                                    "patch",
                                    "summary",
                                    "output"
                                ]
                            }
                        }
                    }
                },
                "createdBy": {
                    "$ref": "#/$defs/id"
                },
                "createdAt": {
                    "type": "string",
                    "format": "date-time"
                }
            }
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "agent": {
                        "type": "object"
                    }
                },
                "required": [
                    "agent"
                ]
            },
            "then": {}
        }
    ],
    "$defs": {
        "id": {
            "type": "string",
            "format": "uuid"
        },
        "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,95}$"
        },
        "capability": {
            "enum": [
                "task.one-shot",
                "message.follow-up",
                "conversation.resume",
                "event.structured",
                "event.streaming",
                "tool.native",
                "tool.mcp",
                "output.patch",
                "output.artifact",
                "checkpoint.recovery",
                "model.select",
                "provider.configure",
                "approval.prompt",
                "cancel.graceful"
            ]
        }
    },
    "x-blazn-invariants": [
        "agent.currentVersionId == version.id",
        "agent.id == version.agentId",
        "agent.workspaceId == version.workspaceId",
        "default profile belongs to allowed profiles",
        "published versions are immutable",
        "raw credentials are forbidden"
    ]
}
