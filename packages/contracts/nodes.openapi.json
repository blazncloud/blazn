{
  "openapi": "3.1.0",
  "info": {"title": "Blazn Nodes API", "version": "nodes/v1alpha1"},
  "servers": [{"url": "https://blazn.benpelo.com"}],
  "security": [{"bearerAuth": []}],
  "paths": {
    "/v1/workspaces/{workspaceId}/node-enrollments": {
      "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}],
      "post": {"operationId": "createNodeEnrollment", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateNodeEnrollmentRequest"}}}}, "responses": {"201": {"description": "Created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NodeEnrollmentSecret"}}}}, "default": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/node-enrollments/{enrollmentId}/exchange": {
      "parameters": [{"$ref": "#/components/parameters/EnrollmentId"}],
      "post": {"operationId": "exchangeNodeEnrollment", "security": [], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExchangeNodeEnrollmentRequest"}}}}, "responses": {"200": {"description": "Signed install plan and exact created identity metadata", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExchangeNodeEnrollmentResponse"}}}}, "default": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/workspaces/{workspaceId}/nodes": {
      "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}],
      "get": {"operationId": "listNodes", "responses": {"200": {"description": "Nodes", "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["items"], "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/Node"}}}}}}}, "default": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/nodes/{nodeId}": {
      "parameters": [{"$ref": "#/components/parameters/NodeId"}],
      "get": {"operationId": "getNode", "responses": {"200": {"description": "Node", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Node"}}}}, "default": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/nodes/{nodeId}/operations": {
      "parameters": [{"$ref": "#/components/parameters/NodeId"}],
      "post": {"operationId": "createNodeOperation", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateNodeOperationRequest"}}}}, "responses": {"202": {"description": "Accepted", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NodeOperation"}}}}, "default": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/nodes/{nodeId}/events": {
      "parameters": [{"$ref": "#/components/parameters/NodeId"}],
      "get": {"operationId": "streamNodeEvents", "parameters": [{"$ref": "#/components/parameters/LastEventId"}], "responses": {"200": {"description": "SSE stream", "content": {"text/event-stream": {"schema": {"type": "string"}}}}, "default": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/node-service/heartbeats": {
      "post": {"operationId": "submitNodeHeartbeat", "security": [{"nodeProof": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NodeHeartbeat"}}}}, "responses": {"204": {"description": "Accepted"}, "default": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/node-service/join-credentials": {
      "post": {"operationId": "issueNodeJoinCredential", "security": [{"nodeProof": []}], "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JoinCredentialRequest"}}}}, "responses": {"200": {"description": "Single-use credential", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JoinCredential"}}}}, "default": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/node-service/join-credentials/{issuanceId}/consume": {
      "parameters": [{"name": "issuanceId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
      "post": {"operationId": "consumeNodeJoinCredential", "security": [{"nodeProof": []}], "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ConsumeJoinCredentialRequest"}}}}, "responses": {"200": {"description": "Bound Node", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Node"}}}}, "default": {"$ref": "#/components/responses/Error"}}}
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "opaque"},
      "nodeProof": {"type": "apiKey", "in": "header", "name": "X-Blazn-Node-Proof"}
    },
    "parameters": {
      "WorkspaceId": {"name": "workspaceId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "NodeId": {"name": "nodeId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "EnrollmentId": {"name": "enrollmentId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"}},
      "LastEventId": {"name": "Last-Event-ID", "in": "header", "required": false, "schema": {"type": "string", "minLength": 1, "maxLength": 128}}
    },
    "responses": {"Error": {"description": "Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NodeError"}}}}},
    "schemas": {
      "NodeError": {
        "type": "object", "additionalProperties": false,
        "required": ["code", "message", "requestId"],
        "x-blazn-error-status": {
          "access_expired": 401, "authorization_capacity": 503, "authorization_not_found": 404, "authorization_pending": 428,
          "capability_digest_invalid": 400, "device_not_found": 404, "device_proof_invalid": 403, "device_revoked": 401,
          "enrollment_consumed": 410, "enrollment_expired": 410, "enrollment_invalid": 400, "enrollment_not_found": 404,
          "expired_token": 400, "forwarded_identity_invalid": 400, "heartbeat_replay": 409, "heartbeat_skew": 400,
          "identity_rejected": 403, "idempotency_conflict": 409, "internal_error": 500, "invalid_json": 400,
          "invalid_public_key": 400, "invalid_request": 400, "join_credential_consumed": 410, "join_credential_invalid": 400,
          "membership_required": 403, "method_not_allowed": 405, "node_not_found": 404, "not_found": 404,
          "object_storage_unavailable": 503, "permission_denied": 403, "proxy_auth_invalid": 403, "rate_limited": 429,
          "request_too_large": 413, "session_revoked": 401, "slow_down": 429, "state_conflict": 409, "unauthorized": 401,
          "version_conflict": 409
        },
        "properties": {
          "code": {"type": "string", "enum": [
            "access_expired", "authorization_capacity", "authorization_not_found", "authorization_pending",
            "capability_digest_invalid", "device_not_found", "device_proof_invalid", "device_revoked",
            "enrollment_consumed", "enrollment_expired", "enrollment_invalid", "enrollment_not_found",
            "expired_token", "forwarded_identity_invalid", "heartbeat_replay", "heartbeat_skew",
            "identity_rejected", "idempotency_conflict", "internal_error", "invalid_json", "invalid_public_key", "invalid_request",
            "join_credential_consumed", "join_credential_invalid", "membership_required", "method_not_allowed", "node_not_found", "not_found",
            "object_storage_unavailable", "permission_denied", "proxy_auth_invalid", "rate_limited", "request_too_large",
            "session_revoked", "slow_down", "state_conflict", "unauthorized", "version_conflict"
          ]},
          "message": {"type": "string", "minLength": 1, "maxLength": 1024},
          "requestId": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      },
      "CreateNodeEnrollmentRequest": {"type": "object", "additionalProperties": false, "required": ["name", "mode", "platform"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 128}, "mode": {"enum": ["fresh", "adopt"]}, "platform": {"enum": ["linux", "macos"]}, "architecture": {"enum": ["amd64", "arm64"]}}},
      "NodeEnrollmentSecret": {"type": "object", "additionalProperties": false, "required": ["id", "token", "tokenKeyId", "planSigningKey", "expiresAt", "replayed"], "properties": {"id": {"type": "string", "format": "uuid"}, "token": {"type": "string", "minLength": 43, "maxLength": 128}, "tokenKeyId": {"const": "node-enrollment/v1"}, "planSigningKey": {"$ref": "#/components/schemas/NodePlanSigningKey"}, "expiresAt": {"type": "string", "format": "date-time"}, "replayed": {"type": "boolean"}}},
      "NodePlanSigningKey": {"type": "object", "additionalProperties": false, "required": ["keyId", "publicKey", "fingerprint"], "properties": {"keyId": {"type": "string", "minLength": 1, "maxLength": 128}, "publicKey": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"}, "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
      "ExchangeNodeEnrollmentResponse": {"type": "object", "additionalProperties": false, "required": ["plan", "identity"], "properties": {"plan": {"$ref": "nodes/node-install-plan.schema.json"}, "identity": {"$ref": "#/components/schemas/NodeEnrollmentIdentity"}}},
      "NodeEnrollmentIdentity": {"type": "object", "additionalProperties": false, "required": ["generation", "signingKeyId", "publicKeyFingerprint", "issuedAt", "expiresAt"], "properties": {"generation": {"type": "integer", "minimum": 1}, "signingKeyId": {"type": "string", "minLength": 1, "maxLength": 128}, "publicKeyFingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "issuedAt": {"type": "string", "format": "date-time"}, "expiresAt": {"type": "string", "format": "date-time"}}},
      "ExchangeNodeEnrollmentRequest": {"type": "object", "additionalProperties": false, "required": ["token", "machineFingerprint", "nodePublicKey", "platform", "architecture"], "properties": {"token": {"type": "string", "minLength": 43, "maxLength": 128}, "machineFingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "nodePublicKey": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"}, "platform": {"enum": ["linux", "macos"]}, "architecture": {"enum": ["amd64", "arm64"]}, "kubernetesBinding": {"$ref": "#/components/schemas/KubernetesBinding"}}},
      "Node": {"type": "object", "additionalProperties": false, "required": ["id", "workspaceId", "name", "kind", "platform", "architecture", "lifecycleState", "trustState", "agentEligible", "version", "capabilityVersion", "identity", "createdAt", "updatedAt"], "properties": {"id": {"type": "string", "format": "uuid"}, "workspaceId": {"type": "string", "format": "uuid"}, "name": {"type": "string"}, "kind": {"enum": ["personal", "shared", "managed"]}, "platform": {"enum": ["linux", "macos"]}, "architecture": {"enum": ["amd64", "arm64"]}, "lifecycleState": {"enum": ["pending", "installing", "verifying", "active", "paused", "draining", "offline", "quarantined", "removed"]}, "trustState": {"enum": ["unverified", "verifying", "verified", "rotating", "revoked"]}, "agentEligible": {"type": "boolean"}, "version": {"type": "integer", "minimum": 1}, "capabilityVersion": {"type": ["integer", "null"], "minimum": 1}, "identity": {"oneOf": [{"$ref": "#/components/schemas/NodeIdentity"}, {"type": "null"}]}, "kubernetesBinding": {"oneOf": [{"$ref": "#/components/schemas/KubernetesBinding"}, {"type": "null"}]}, "createdAt": {"type": "string", "format": "date-time"}, "updatedAt": {"type": "string", "format": "date-time"}}},
      "NodeIdentity": {"type": "object", "additionalProperties": false, "required": ["generation", "publicKeyFingerprint", "status", "issuedAt", "expiresAt"], "properties": {"generation": {"type": "integer", "minimum": 1}, "publicKeyFingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "status": {"enum": ["active", "rotating", "revoked", "expired"]}, "issuedAt": {"type": "string", "format": "date-time"}, "expiresAt": {"type": "string", "format": "date-time"}}},
      "KubernetesBinding": {"type": "object", "additionalProperties": false, "required": ["clusterId", "nodeName", "nodeUid", "resourceVersion"], "properties": {"clusterId": {"type": "string", "minLength": 1, "maxLength": 128}, "nodeName": {"type": "string", "minLength": 1, "maxLength": 253}, "nodeUid": {"type": "string", "minLength": 1, "maxLength": 128}, "resourceVersion": {"type": "string", "minLength": 1, "maxLength": 128}}},
      "CreateNodeOperationRequest": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "expectedVersion", "parameters"],
        "properties": {
          "type": {"enum": ["pause", "resume", "label", "cordon", "uncordon", "rotate_identity", "repair", "update", "drain", "remove"]},
          "expectedVersion": {"type": "integer", "minimum": 1},
          "parameters": {"type": "object", "maxProperties": 8}
        },
        "allOf": [
          {"if": {"properties": {"type": {"enum": ["pause", "resume", "rotate_identity", "repair"]}}, "required": ["type"]}, "then": {"properties": {"parameters": {"maxProperties": 0}}}},
          {"if": {"properties": {"type": {"const": "label"}}, "required": ["type"]}, "then": {"properties": {"parameters": {"additionalProperties": false, "required": ["key", "value"], "properties": {"key": {"type": "string", "pattern": "^blazn\\.dev/[a-z0-9][a-z0-9._-]{0,62}$"}, "value": {"type": "string", "maxLength": 128}}}}}},
          {"if": {"properties": {"type": {"enum": ["cordon", "uncordon"]}}, "required": ["type"]}, "then": {"properties": {"parameters": {"$ref": "#/components/schemas/KubernetesMutationParameters"}}}},
          {"if": {"properties": {"type": {"const": "drain"}}, "required": ["type"]}, "then": {"properties": {"parameters": {"$ref": "#/components/schemas/DrainParameters"}}}},
          {"if": {"properties": {"type": {"const": "remove"}}, "required": ["type"]}, "then": {"properties": {"parameters": {"$ref": "#/components/schemas/RemoveParameters"}}}},
          {"if": {"properties": {"type": {"const": "update"}}, "required": ["type"]}, "then": {"properties": {"parameters": {"type": "object", "additionalProperties": false, "required": ["targetVersion"], "properties": {"targetVersion": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$", "maxLength": 128}}}}}}
        ]
      },
      "KubernetesMutationParameters": {"type": "object", "additionalProperties": false, "required": ["clusterId", "expectedNodeUid", "expectedResourceVersion"], "properties": {"clusterId": {"type": "string", "minLength": 1, "maxLength": 128}, "expectedNodeUid": {"type": "string", "minLength": 1, "maxLength": 128}, "expectedResourceVersion": {"type": "string", "minLength": 1, "maxLength": 128}}},
      "DrainParameters": {"type": "object", "additionalProperties": false, "required": ["clusterId", "expectedNodeUid", "expectedResourceVersion", "workspaceId", "deadlineSeconds"], "properties": {"clusterId": {"type": "string", "minLength": 1, "maxLength": 128}, "expectedNodeUid": {"type": "string", "minLength": 1, "maxLength": 128}, "expectedResourceVersion": {"type": "string", "minLength": 1, "maxLength": 128}, "workspaceId": {"type": "string", "format": "uuid"}, "deadlineSeconds": {"type": "integer", "minimum": 60, "maximum": 3600}}},
      "RemoveParameters": {"type": "object", "additionalProperties": false, "required": ["clusterId", "expectedNodeUid", "expectedResourceVersion", "confirm", "preserveHostData"], "properties": {"clusterId": {"type": "string", "minLength": 1, "maxLength": 128}, "expectedNodeUid": {"type": "string", "minLength": 1, "maxLength": 128}, "expectedResourceVersion": {"type": "string", "minLength": 1, "maxLength": 128}, "confirm": {"const": true}, "preserveHostData": {"const": true}}},
      "NodeOperation": {"type": "object", "additionalProperties": false, "required": ["id", "nodeId", "type", "status", "expectedNodeVersion", "result", "error", "receipt", "createdAt"], "properties": {"id": {"type": "string", "format": "uuid"}, "nodeId": {"type": "string", "format": "uuid"}, "type": {"enum": ["pause", "resume", "label", "cordon", "uncordon", "rotate_identity", "repair", "update", "drain", "remove"]}, "status": {"enum": ["pending", "running", "succeeded", "failed", "cancelled", "partial", "recovery_required"]}, "expectedNodeVersion": {"type": "integer", "minimum": 1}, "result": {"type": ["object", "null"]}, "error": {"oneOf": [{"$ref": "#/components/schemas/NodeError"}, {"type": "null"}]}, "receipt": {"oneOf": [{"$ref": "nodes/node-operation-receipt.schema.json"}, {"type": "null"}]}, "createdAt": {"type": "string", "format": "date-time"}}},
      "NodeHeartbeat": {"type": "object", "additionalProperties": false, "required": ["nodeId", "identityGeneration", "bootId", "sequence", "sentAt", "capabilityDigest", "capability"], "properties": {"nodeId": {"type": "string", "format": "uuid"}, "identityGeneration": {"type": "integer", "minimum": 1}, "bootId": {"type": "string", "minLength": 1, "maxLength": 128}, "sequence": {"type": "integer", "minimum": 0}, "sentAt": {"type": "string", "format": "date-time"}, "capabilityDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "capability": {"$ref": "#/components/schemas/NodeCapability"}}},
      "NodeCapability": {
        "type": "object", "additionalProperties": false,
        "required": ["version", "host", "worker", "sandboxBackends", "runtimeClasses", "localModels"],
        "properties": {
          "version": {"type": "integer", "minimum": 1},
          "host": {"$ref": "#/components/schemas/HostCapacity"},
          "worker": {"$ref": "#/components/schemas/WorkerCapacity"},
          "sandboxBackends": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 128}},
          "runtimeClasses": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 128}},
          "localModels": {"type": "array", "maxItems": 32, "items": {"$ref": "#/components/schemas/LocalModelCapability"}}
        }
      },
      "HostCapacity": {"type": "object", "additionalProperties": false, "required": ["platform", "architecture", "cpuMillis", "memoryBytes", "diskBytes", "accelerators", "health"], "properties": {"platform": {"enum": ["linux", "macos"]}, "architecture": {"enum": ["amd64", "arm64"]}, "cpuMillis": {"type": "integer", "minimum": 1}, "memoryBytes": {"type": "integer", "minimum": 1}, "diskBytes": {"type": "integer", "minimum": 1}, "accelerators": {"type": "array", "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["kind", "count"], "properties": {"kind": {"type": "string", "minLength": 1, "maxLength": 128}, "count": {"type": "integer", "minimum": 1}}}}, "health": {"$ref": "#/components/schemas/NodeHealth"}}},
      "WorkerCapacity": {"type": "object", "additionalProperties": false, "required": ["platform", "architecture", "allocatableCpuMillis", "allocatableMemoryBytes", "allocatableDiskBytes", "labels", "limits", "health", "kubernetesBinding"], "properties": {"platform": {"const": "linux"}, "architecture": {"enum": ["amd64", "arm64"]}, "allocatableCpuMillis": {"type": "integer", "minimum": 1}, "allocatableMemoryBytes": {"type": "integer", "minimum": 1}, "allocatableDiskBytes": {"type": "integer", "minimum": 1}, "labels": {"type": "object", "maxProperties": 64, "propertyNames": {"pattern": "^blazn\\.dev/[a-z0-9][a-z0-9._-]{0,62}$"}, "additionalProperties": {"type": "string", "maxLength": 128}}, "limits": {"type": "object", "additionalProperties": false, "required": ["maxConcurrentSandboxes", "maxConcurrentAgents"], "properties": {"maxConcurrentSandboxes": {"type": "integer", "minimum": 0, "maximum": 1024}, "maxConcurrentAgents": {"type": "integer", "minimum": 0, "maximum": 1024}}}, "health": {"$ref": "#/components/schemas/NodeHealth"}, "kubernetesBinding": {"$ref": "#/components/schemas/KubernetesBinding"}}},
      "NodeHealth": {"type": "object", "additionalProperties": false, "required": ["status", "reasonCodes"], "properties": {"status": {"enum": ["healthy", "degraded", "unavailable"]}, "reasonCodes": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_]{1,64}$"}}}},
      "LocalModelCapability": {"type": "object", "additionalProperties": false, "required": ["routeId", "displayName", "model", "protocol", "endpointClass", "capabilities", "dataBoundary", "healthy", "maxConcurrency", "maxContextTokens", "maxOutputTokens"], "properties": {"routeId": {"type": "string", "format": "uuid"}, "displayName": {"type": "string", "minLength": 1, "maxLength": 128}, "model": {"type": "string", "minLength": 1, "maxLength": 160}, "protocol": {"enum": ["openai-chat", "openai-responses"]}, "endpointClass": {"enum": ["loopback", "authenticated_node_tunnel"]}, "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["text", "tools", "structured_output", "streaming"]}}, "dataBoundary": {"const": "local"}, "healthy": {"type": "boolean"}, "maxConcurrency": {"type": "integer", "minimum": 1}, "maxContextTokens": {"type": "integer", "minimum": 1}, "maxOutputTokens": {"type": "integer", "minimum": 1}}},
      "JoinCredentialRequest": {"type": "object", "additionalProperties": false, "required": ["enrollmentId", "planId", "planDigest", "nodeId", "machineFingerprint", "nodePublicKeyFingerprint"], "properties": {"enrollmentId": {"type": "string", "format": "uuid"}, "planId": {"type": "string", "format": "uuid"}, "planDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "nodeId": {"type": "string", "format": "uuid"}, "machineFingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "nodePublicKeyFingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
      "JoinCredential": {"type": "object", "additionalProperties": false, "required": ["issuanceId", "credential", "expiresAt", "clusterId", "workerOnly", "replayed"], "properties": {"issuanceId": {"type": "string", "format": "uuid"}, "credential": {"type": "string", "minLength": 43, "maxLength": 4096}, "expiresAt": {"type": "string", "format": "date-time"}, "clusterId": {"type": "string", "minLength": 1, "maxLength": 128}, "workerOnly": {"const": true}, "replayed": {"type": "boolean"}}},
      "ConsumeJoinCredentialRequest": {"type": "object", "additionalProperties": false, "required": ["nodeId", "enrollmentId", "planId", "joinedNodeUid", "joinedNodeName", "resourceVersion", "clusterId"], "properties": {"nodeId": {"type": "string", "format": "uuid"}, "enrollmentId": {"type": "string", "format": "uuid"}, "planId": {"type": "string", "format": "uuid"}, "joinedNodeUid": {"type": "string", "minLength": 1, "maxLength": 128}, "joinedNodeName": {"type": "string", "minLength": 1, "maxLength": 253}, "resourceVersion": {"type": "string", "minLength": 1, "maxLength": 128}, "clusterId": {"type": "string", "minLength": 1, "maxLength": 128}}}
    }
  }
}
