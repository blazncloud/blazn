                    "run": {
                        "properties": {
                            "sandboxId": {
                                "type": "null"
                            },
                            "status": {
                                "const": "failed"
                            }
                        }
                    },
                    "provenance": {"properties":{"proxyDecision":{"type":"null"},"fallbackAttempt":{"type":"null"},"billing":{"properties":{"mode":{"const":"zero-cost"},"amountMicros":{"const":0},"source":{"const":"control-plane-receipt"}}},"node":{"type":"null"}}},
                    "result": {
                        "type": "object",
                        "properties": {
                            "status": {
                                "const": "failed"
                            },
                            "summary": {"const": "Harness capability mismatch refused before Sandbox allocation."},
                            "artifactIds": {"maxItems": 0},
                            "artifacts": {"maxItems": 0},
                            "patchArtifactId": {"type": "null"},
                            "usage": {
                                "properties": {
                                    "modelRequests": {"const": 0},
                                    "inputTokens": {"const": 0},
                                    "outputTokens": {"const": 0}
                                }
                            }
                        },
                        "required": [
                            "status"
                        ]
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "run": {
                        "properties": {
