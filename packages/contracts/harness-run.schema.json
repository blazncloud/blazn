                "proxyDecision": {"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["eventId","requestId","outcome","routeId","routeVersion","policyId","policyVersion","authentication","authorizationId"],"properties":{"eventId":{"$ref":"#/$defs/id"},"requestId":{"$ref":"#/$defs/id"},"outcome":{"enum":["ROUTED","DIRECT","BYPASS"]},"routeId":{"$ref":"#/$defs/id"},"routeVersion":{"type":"integer","minimum":1},"policyId":{"$ref":"#/$defs/id"},"policyVersion":{"type":"integer","minimum":1},"authentication":{"enum":["proxy-workload-proof","provider-capability-proof"]},"authorizationId":{"oneOf":[{"$ref":"#/$defs/id"},{"type":"null"}]}}}]},
                "fallbackAttempt": {"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["attempt","approved","primaryFailureEventId","approvalEventId","requestEventId","decisionEventId","primaryRouteId","primaryRouteVersion","fallbackRouteId","fallbackRouteVersion","authorizationId","approvalReceiptId","requestId","receiptId","policyId","policyVersion"],"properties":{"attempt":{"const":1},"approved":{"const":true},"primaryFailureEventId":{"$ref":"#/$defs/id"},"approvalEventId":{"$ref":"#/$defs/id"},"requestEventId":{"$ref":"#/$defs/id"},"decisionEventId":{"$ref":"#/$defs/id"},"primaryRouteId":{"$ref":"#/$defs/id"},"primaryRouteVersion":{"type":"integer","minimum":1},"fallbackRouteId":{"$ref":"#/$defs/id"},"fallbackRouteVersion":{"type":"integer","minimum":1},"authorizationId":{"$ref":"#/$defs/id"},"approvalReceiptId":{"$ref":"#/$defs/id"},"requestId":{"$ref":"#/$defs/id"},"receiptId":{"$ref":"#/$defs/id"},"policyId":{"$ref":"#/$defs/id"},"policyVersion":{"type":"integer","minimum":1}}}]},
                "billing": {"type":"object","additionalProperties":false,"required":["mode","currency","amountMicros","pricingId","pricingVersion","receiptId","source"],"properties":{"mode":{"enum":["priced","zero-cost"]},"currency":{"const":"USD"},"amountMicros":{"type":"integer","minimum":0},"pricingId":{"$ref":"#/$defs/id"},"pricingVersion":{"type":"integer","minimum":1},"receiptId":{"$ref":"#/$defs/id"},"source":{"enum":["proxy-receipt","control-plane-receipt"]}},"allOf":[{"if":{"properties":{"mode":{"const":"zero-cost"}},"required":["mode"]},"then":{"properties":{"amountMicros":{"const":0}}}},{"if":{"properties":{"mode":{"const":"priced"}},"required":["mode"]},"then":{"properties":{"amountMicros":{"minimum":1}}}}]},
                "node": {"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["id","architecture","bindingUid","bindingResourceVersion"],"properties":{"id":{"$ref":"#/$defs/id"},"architecture":{"enum":["amd64","arm64"]},"bindingUid":{"type":"string","minLength":1,"maxLength":128},"bindingResourceVersion":{"type":"string","minLength":1,"maxLength":128}}}]},
                "workerProtocol": {
