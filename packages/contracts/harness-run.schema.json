    "$defs": {
        "id": {
            "type": "string",
            "format": "uuid"
        },
        "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "versionRef": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "digest"
            ],
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "digest": {
                    "$ref": "#/$defs/digest"
                }
            }
        },
        "capabilities": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
                "enum": [
                    "task.one-shot",
                    "message.follow-up",
                    "conversation.resume",
                    "event.structured",
                    "event.streaming",
                    "tool.native",
                    "tool.mcp",
                    "output.patch",
                    "output.artifact",
                    "checkpoint.recovery",
                    "model.select",
                    "provider.configure",
                    "approval.prompt",
                    "cancel.graceful"
                ]
            }
        },
        "event": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schemaVersion",
                "id",
                "runId",
                "sessionId",
                "sequence",
                "cursor",
                "type",
                "source",
                "observedAt",
                "payload",
                "extensions"
            ],
            "properties": {
                "schemaVersion": {
                    "const": "blazn.dev/harness-event/v1alpha1"
                },
                "id": {
                    "$ref": "#/$defs/id"
                },
                "runId": {
                    "$ref": "#/$defs/id"
                },
                "sessionId": {
                    "$ref": "#/$defs/id"
                },
                "sequence": {
                    "type": "integer",
                    "minimum": 0
                },
                "cursor": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._:-]{1,128}$"
                },
                "type": {
                    "enum": [
                        "harness.preparing",
                        "harness.ready",
                        "harness.started",
                        "harness.waiting",
                        "harness.resumed",
                        "harness.stopping",
                        "harness.exited",
                        "message.user",
                        "message.assistant",
                        "message.tool",
                        "tool.requested",
                        "tool.approved",
                        "tool.started",
                        "tool.completed",
                        "tool.denied",
                        "tool.failed",
                        "approval.requested",
                        "approval.resolved",
                        "model.requested",
                        "model.proxy-decided",
                        "model.fallback-authorized",
                        "model.fallback-decided",
                        "model.usage",
                        "billing.recorded",
                        "artifact.created",
                        "patch.created",
                        "progress",
                        "warning",
                        "error",
                        "followup.accepted",
                        "cancellation.requested",
                        "cancellation.acknowledged",
                        "timeout",
                        "result.terminal"
                    ]
                },
                "source": {
                    "enum": [
                        "control-plane",
                        "adapter",
                        "harness",
                        "proxy",
                        "sandbox"
                    ]
                },
                "observedAt": {
                    "type": "string",
                    "format": "date-time"
                },
                "payload": {
                    "type": "object",
                    "maxProperties": 32,
                    "additionalProperties": {
                        "type": [
                            "string",
                            "number",
                            "integer",
                            "boolean",
                            "null"
                        ],
                        "maxLength": 4096
                    }
                },
                "extensions": {
                    "type": "object",
                    "maxProperties": 8,
                    "propertyNames": {
                        "pattern": "^(?:hermes|codex|claude|generic)\\.[a-z][a-z0-9._-]{0,63}$"
                    },
                    "additionalProperties": {
                        "type": "object",
                        "maxProperties": 32,
                        "propertyNames": {
                            "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
                        },
                        "additionalProperties": {
                            "type": [
                                "string",
                                "number",
                                "integer",
                                "boolean",
                                "null"
                            ],
                            "maxLength": 4096
                        }
                    }
                }
            },
            "allOf": [
                {
                    "if": {"properties":{"type":{"const":"model.proxy-decided"}},"required":["type"]},
                    "then": {
                        "properties": {
                            "payload": {
                                "additionalProperties": false,
                                "required": ["requestId","outcome","routeId","routeVersion","policyId","policyVersion","authentication","authorizationId"],
                                "properties": {
                                    "requestId": {"$ref":"#/$defs/id"},
                                    "outcome": {"enum":["ROUTED","DIRECT","BYPASS"]},
                                    "routeId": {"$ref":"#/$defs/id"},
                                    "routeVersion": {"type":"integer","minimum":1},
                                    "policyId": {"$ref":"#/$defs/id"},
                                    "policyVersion": {"type":"integer","minimum":1},
                                    "authentication": {"enum":["proxy-workload-proof","provider-capability-proof"]},
                                    "authorizationId": {"oneOf":[{"$ref":"#/$defs/id"},{"type":"null"}]}
                                }
                            },
                            "extensions": {"maxProperties":0}
                        }
                    }
                },
                {
                    "if": {"properties":{"type":{"const":"billing.recorded"}},"required":["type"]},
                    "then": {
                        "properties": {
                            "payload": {
                                "additionalProperties": false,
                                "required": ["mode","currency","amountMicros","pricingId","pricingVersion","receiptId","source"],
                                "properties": {
                                    "mode": {"enum":["priced","zero-cost"]},
                                    "currency": {"const":"USD"},
                                    "amountMicros": {"type":"integer","minimum":0},
