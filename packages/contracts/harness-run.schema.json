                    "$ref": "#/$defs/capabilities"
                }
            }
        },
        "credentialLeases":{"type":"array","maxItems":16,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["id","capability","scope","issuedAt","expiresAt","status","revokedAt"],"properties":{"id":{"$ref":"#/$defs/id"},"capability":{"enum":["model.openai","model.anthropic","model.proxy","repository.read","tool.mcp"]},"scope":{"type":"string","pattern":"^(?:route|repo|tool):[a-z0-9][a-z0-9.:/_-]{0,119}$"},"issuedAt":{"type":"string","format":"date-time"},"expiresAt":{"type":"string","format":"date-time"},"status":{"enum":["active","revoked"]},"revokedAt":{"oneOf":[{"type":"null"},{"type":"string","format":"date-time"}]}},"allOf":[{"if":{"properties":{"status":{"const":"active"}},"required":["status"]},"then":{"properties":{"revokedAt":{"type":"null"}}}},{"if":{"properties":{"status":{"const":"revoked"}},"required":["status"]},"then":{"properties":{"revokedAt":{"type":"string","format":"date-time"}}}}]}},
        "messages":{"type":"array","maxItems":1000,"items":{"type":"object","additionalProperties":false,"required":["id","runId","sessionId","conversationId","generation","ordinal","role","contentDigest","createdAt"],"properties":{"id":{"$ref":"#/$defs/id"},"runId":{"$ref":"#/$defs/id"},"sessionId":{"$ref":"#/$defs/id"},"conversationId":{"$ref":"#/$defs/id"},"generation":{"type":"integer","minimum":0,"maximum":100},"ordinal":{"type":"integer","minimum":1,"maximum":10000},"role":{"enum":["user","assistant","tool"]},"parentMessageId":{"oneOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},"followUpToMessageId":{"oneOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},"contentDigest":{"$ref":"#/$defs/digest"},"createdAt":{"type":"string","format":"date-time"}}}},
