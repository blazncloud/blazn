                                    "type": {"const": "result.terminal"},
                                    "source": {"const": "control-plane"},
                                    "payload": {
                                        "additionalProperties": false,
                                        "properties": {"status": {"const": "failed"}},
                                        "required": ["status"]
                                    },
                                    "extensions": {"maxProperties": 0}
                                },
                                "required": ["type", "source", "payload", "extensions"]
                            }
                        ]
                    },
                    "session": {
                        "properties": {
                            "messageCursor": {"const": 0},
                            "eventCursor": {"const": 1},
                            "followUpCount": {"const": 0},
                            "resumeGeneration": {"const": 0},
                            "cancellation": {
                                "properties": {
                                    "requested": {"const": false},
                                    "acknowledged": {"const": false},
                                    "processTreeTerminated": {"const": false},
                                    "cleanupComplete": {"const": false},
                                    "credentialsRevoked": {"const": false},
                                    "artifactsHandled": {"const": false}
                                }
                            }
