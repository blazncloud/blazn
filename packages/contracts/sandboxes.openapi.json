{
  "openapi": "3.1.0",
  "info": {"title": "Blazn Sandbox API Overlay", "version": "v1alpha1"},
  "servers": [{"url": "https://blazn.benpelo.com"}],
  "security": [{"bearerAuth": []}],
  "paths": {
    "/v1/workspaces/{workspaceId}/sandbox-templates": {
      "post": {"operationId": "createSandboxTemplate", "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "sandbox-template.schema.json"}}}}, "responses": {"201": {"description": "Draft template created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SandboxTemplateEnvelope"}}}}, "default": {"$ref": "#/components/responses/SandboxError"}}},
      "get": {"operationId": "listSandboxTemplates", "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/Cursor"}], "responses": {"200": {"description": "Visible templates", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SandboxTemplateList"}}}}, "default": {"$ref": "#/components/responses/SandboxError"}}}
    },
    "/v1/sandbox-templates/{templateId}": {
      "get": {"operationId": "getSandboxTemplate", "parameters": [{"$ref": "#/components/parameters/TemplateId"}], "responses": {"200": {"description": "Template", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SandboxTemplateEnvelope"}}}}, "default": {"$ref": "#/components/responses/SandboxError"}}}
    },
    "/v1/sandbox-templates/{templateId}/draft": {
      "put": {"operationId": "replaceSandboxTemplateDraft", "parameters": [{"$ref": "#/components/parameters/TemplateId"}, {"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReplaceTemplateDraftRequest"}}}}, "responses": {"200": {"description": "Draft replaced", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SandboxTemplateEnvelope"}}}}, "default": {"$ref": "#/components/responses/SandboxError"}}}
    },
    "/v1/sandbox-templates/{templateId}/versions": {
      "post": {"operationId": "publishSandboxTemplateVersion", "parameters": [{"$ref": "#/components/parameters/TemplateId"}, {"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PublishTemplateVersionRequest"}}}}, "responses": {"201": {"description": "Immutable version published", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SandboxTemplateVersionEnvelope"}}}}, "default": {"$ref": "#/components/responses/SandboxError"}}},
      "get": {"operationId": "listSandboxTemplateVersions", "parameters": [{"$ref": "#/components/parameters/TemplateId"}, {"$ref": "#/components/parameters/Cursor"}], "responses": {"200": {"description": "Published versions", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SandboxTemplateVersionList"}}}}, "default": {"$ref": "#/components/responses/SandboxError"}}}
    },
    "/v1/sandbox-template-versions/{versionId}": {
      "get": {"operationId": "getSandboxTemplateVersion", "parameters": [{"$ref": "#/components/parameters/VersionId"}], "responses": {"200": {"description": "Immutable template version", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SandboxTemplateVersionEnvelope"}}}}, "default": {"$ref": "#/components/responses/SandboxError"}}}
    },
    "/v1/workspaces/{workspaceId}/sandboxes": {
      "post": {"operationId": "createSandbox", "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateSandboxRequest"}}}}, "responses": {"202": {"description": "Sandbox accepted and exact immutable inputs bound", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SandboxMutation"}}}}, "default": {"$ref": "#/components/responses/SandboxError"}}},
      "get": {"operationId": "listSandboxes", "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/Cursor"}], "responses": {"200": {"description": "Visible sandboxes", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SandboxList"}}}}, "default": {"$ref": "#/components/responses/SandboxError"}}}
    },
    "/v1/sandboxes/{sandboxId}": {
      "get": {"operationId": "getSandbox", "parameters": [{"$ref": "#/components/parameters/SandboxId"}], "responses": {"200": {"description": "Sandbox without credentials", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Sandbox"}}}}, "default": {"$ref": "#/components/responses/SandboxError"}}}
    },
    "/v1/sandboxes/{sandboxId}/events": {
      "get": {"operationId": "streamSandboxEvents", "parameters": [{"$ref": "#/components/parameters/SandboxId"}, {"$ref": "#/components/parameters/LastEventId"}], "responses": {"200": {"description": "Sandbox-wide globally monotonic typed event stream; each SSE id equals eventId and data is SandboxEvent JSON", "content": {"text/event-stream": {"schema": {"$ref": "#/components/schemas/SandboxEvent"}}}}, "default": {"$ref": "#/components/responses/SandboxError"}}}
    },
    "/v1/sandboxes/{sandboxId}/operations": {
      "post": {"operationId": "createSandboxOperation", "parameters": [{"$ref": "#/components/parameters/SandboxId"}, {"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateSandboxOperationRequest"}}}}, "responses": {"202": {"description": "Durable stop or delete accepted", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SandboxMutation"}}}}, "default": {"$ref": "#/components/responses/SandboxError"}}}
    },
    "/v1/sandboxes/{sandboxId}/access-grants": {
      "post": {"operationId": "createSandboxAccessGrant", "parameters": [{"$ref": "#/components/parameters/SandboxId"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateAccessGrantRequest"}}}}, "responses": {"201": {"description": "A fresh one-time same-origin grant. This operation is intentionally non-idempotent: a retry requests a new grant and invalidates no prior grant. The response is never cacheable and is never stored in an idempotency receipt.", "headers": {"Cache-Control": {"required": true, "schema": {"const": "no-store"}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AccessGrantCreated"}}}}, "default": {"$ref": "#/components/responses/SandboxError"}}}
    },
    "/v1/sandbox-access-grants/{grantId}/exec": {
      "post": {"operationId": "executeSandboxGrant", "security": [{"grantAuth": []}], "parameters": [{"$ref": "#/components/parameters/GrantId"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExecRequest"}}}}, "responses": {"200": {"description": "Bounded execution result", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExecResult"}}}}, "default": {"$ref": "#/components/responses/SandboxError"}}}
    },
    "/v1/sandbox-access-grants/{grantId}/file": {
      "put": {"operationId": "uploadSandboxGrantFile", "security": [{"grantAuth": []}], "parameters": [{"$ref": "#/components/parameters/GrantId"}, {"$ref": "#/components/parameters/SandboxPath"}, {"$ref": "#/components/parameters/ContentSize"}, {"$ref": "#/components/parameters/ContentSHA256"}], "requestBody": {"required": true, "content": {"application/octet-stream": {"schema": {"type": "string", "format": "binary", "contentMediaType": "application/octet-stream"}}}}, "responses": {"200": {"description": "Uploaded regular file with exact declared size and digest", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FileTransferResult"}}}}, "default": {"$ref": "#/components/responses/SandboxError"}}},
      "get": {"operationId": "downloadSandboxGrantFile", "security": [{"grantAuth": []}], "parameters": [{"$ref": "#/components/parameters/GrantId"}, {"$ref": "#/components/parameters/SandboxPath"}], "responses": {"200": {"description": "Raw regular-file bytes, possibly chunked, with mandatory exact size and digest metadata; receivers enforce 8 MiB while streaming", "headers": {"X-Content-Size": {"required": true, "schema": {"type": "integer", "minimum": 0, "maximum": 8388608}}, "X-Content-SHA256": {"required": true, "schema": {"$ref": "#/components/schemas/Digest"}}}, "content": {"application/octet-stream": {"schema": {"type": "string", "format": "binary", "contentMediaType": "application/octet-stream"}}}}, "default": {"$ref": "#/components/responses/SandboxError"}}}
    },
    "/v1/sandbox-operations/{operationId}": {
      "get": {"operationId": "getSandboxOperation", "parameters": [{"$ref": "#/components/parameters/OperationId"}], "responses": {"200": {"description": "Durable operation and terminal cleanup receipt", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SandboxOperation"}}}}, "default": {"$ref": "#/components/responses/SandboxError"}}}
    },
    "/v1/sandboxes/{sandboxId}/artifacts": {
      "get": {"operationId": "listSandboxArtifacts", "parameters": [{"$ref": "#/components/parameters/SandboxId"}, {"$ref": "#/components/parameters/Cursor"}], "responses": {"200": {"description": "Exported artifact receipts", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SandboxArtifactList"}}}}, "default": {"$ref": "#/components/responses/SandboxError"}}}
    },
    "/v1/sandbox-artifacts/{artifactId}": {
      "get": {"operationId": "getSandboxArtifact", "parameters": [{"$ref": "#/components/parameters/ArtifactId"}], "responses": {"200": {"description": "Artifact receipt and same-origin download metadata", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SandboxArtifact"}}}}, "default": {"$ref": "#/components/responses/SandboxError"}}}
    },
    "/v1/sandbox-artifacts/{artifactId}/content": {
      "get": {"operationId": "downloadSandboxArtifact", "parameters": [{"$ref": "#/components/parameters/ArtifactId"}], "responses": {"200": {"description": "Raw exported artifact bytes; transfer may be chunked and is verified against receipt headers", "headers": {"X-Content-Size": {"required": true, "schema": {"type": "integer", "minimum": 0}}, "X-Content-SHA256": {"required": true, "schema": {"$ref": "#/components/schemas/Digest"}}}, "content": {"application/octet-stream": {"schema": {"type": "string", "format": "binary", "contentMediaType": "application/octet-stream"}}}}, "default": {"$ref": "#/components/responses/SandboxError"}}}
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "opaque"},
      "grantAuth": {"type": "apiKey", "in": "header", "name": "Authorization", "description": "Exactly: Blazn-Grant <one-time-token>"}
    },
    "responses": {"SandboxError": {"description": "Documented sandbox or common error; inaccessible and cross-workspace resources are reported as not found", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SandboxError"}}}}},
    "parameters": {
      "WorkspaceId": {"name": "workspaceId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "TemplateId": {"name": "templateId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "VersionId": {"name": "versionId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "SandboxId": {"name": "sandboxId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "OperationId": {"name": "operationId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "ArtifactId": {"name": "artifactId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "GrantId": {"name": "grantId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 8, "maxLength": 128}},
      "Cursor": {"name": "cursor", "in": "query", "required": false, "schema": {"type": "string", "maxLength": 512}},
      "LastEventId": {"name": "Last-Event-ID", "in": "header", "required": false, "schema": {"type": "string", "maxLength": 128}},
      "SandboxPath": {"name": "X-Blazn-Sandbox-Path", "in": "header", "required": true, "schema": {"type": "string", "pattern": "^/workspace/(?:src|artifacts|tmp)(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._-]+)+$", "maxLength": 512}, "description": "Resolved without following symlinks and confined beneath the sandbox workspace"},
      "ContentSize": {"name": "X-Content-Size", "in": "header", "required": true, "schema": {"type": "integer", "minimum": 0, "maximum": 8388608}},
      "ContentSHA256": {"name": "X-Content-SHA256", "in": "header", "required": true, "schema": {"$ref": "#/components/schemas/Digest"}}
    },
    "schemas": {
      "Digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
      "ImmutableOCIReference": {"type": "string", "pattern": "^(?:(?:localhost|(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?:\\.(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?))+|(?:[0-9]{1,3}\\.){3}[0-9]{1,3})(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?)/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*@sha256:[0-9a-f]{64}$", "maxLength": 512},
      "SandboxError": {"type": "object", "additionalProperties": false, "required": ["code", "message", "requestId"], "x-blazn-error-status": {"template_not_found": 404, "template_name_conflict": 409, "template_version_not_found": 404, "template_version_conflict": 409, "template_invalid": 400, "template_policy_denied": 403, "sandbox_not_found": 404, "sandbox_operation_not_found": 404, "sandbox_artifact_not_found": 404, "sandbox_state_conflict": 409, "sandbox_template_unavailable": 409, "sandbox_architecture_unavailable": 409, "sandbox_access_denied": 404, "access_grant_expired": 410, "access_grant_consumed": 410, "access_grant_revoked": 410, "sandbox_backend_unavailable": 503, "sandbox_cleanup_incomplete": 409, "access_expired": 401, "membership_required": 403, "permission_denied": 403, "version_conflict": 409, "idempotency_conflict": 409, "rate_limited": 429, "unauthorized": 401, "session_revoked": 401, "invalid_json": 400, "invalid_request": 400, "request_too_large": 413, "internal_error": 500}, "properties": {"code": {"type": "string", "enum": ["template_not_found", "template_name_conflict", "template_version_not_found", "template_version_conflict", "template_invalid", "template_policy_denied", "sandbox_not_found", "sandbox_operation_not_found", "sandbox_artifact_not_found", "sandbox_state_conflict", "sandbox_template_unavailable", "sandbox_architecture_unavailable", "sandbox_access_denied", "access_grant_expired", "access_grant_consumed", "access_grant_revoked", "sandbox_backend_unavailable", "sandbox_cleanup_incomplete", "access_expired", "membership_required", "permission_denied", "version_conflict", "idempotency_conflict", "rate_limited", "unauthorized", "session_revoked", "invalid_json", "invalid_request", "request_too_large", "internal_error"]}, "message": {"type": "string", "minLength": 1, "maxLength": 1024}, "requestId": {"type": "string", "minLength": 1, "maxLength": 128}}},
      "SandboxTemplate": {"type": "object", "additionalProperties": false, "required": ["id", "workspaceId", "name", "draftVersion", "publishedVersionId", "createdAt", "updatedAt"], "properties": {"id": {"type": "string", "format": "uuid"}, "workspaceId": {"type": "string", "format": "uuid"}, "name": {"type": "string"}, "draftVersion": {"type": "integer", "minimum": 1}, "draftManifest": {"$ref": "sandbox-template.schema.json", "description": "Present only for owner/administrator draft access"}, "draftDigest": {"$ref": "#/components/schemas/Digest", "description": "Present only for owner/administrator draft access"}, "publishedVersionId": {"type": ["string", "null"], "format": "uuid"}, "createdAt": {"type": "string", "format": "date-time"}, "updatedAt": {"type": "string", "format": "date-time"}}},
      "SandboxTemplateEnvelope": {"type": "object", "additionalProperties": false, "required": ["template"], "properties": {"template": {"$ref": "#/components/schemas/SandboxTemplate"}}},
      "SandboxTemplateList": {"type": "object", "additionalProperties": false, "required": ["items", "nextCursor"], "properties": {"items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/components/schemas/SandboxTemplate"}}, "nextCursor": {"type": ["string", "null"]}}},
      "ReplaceTemplateDraftRequest": {"type": "object", "additionalProperties": false, "required": ["expectedDraftVersion", "manifest"], "properties": {"expectedDraftVersion": {"type": "integer", "minimum": 1}, "manifest": {"$ref": "sandbox-template.schema.json"}}},
      "PublishTemplateVersionRequest": {"type": "object", "additionalProperties": false, "required": ["expectedDraftVersion"], "properties": {"expectedDraftVersion": {"type": "integer", "minimum": 1}}},
      "SandboxTemplateVersion": {"type": "object", "additionalProperties": false, "required": ["id", "workspaceId", "templateId", "name", "version", "contentDigest", "manifest", "status", "createdAt"], "properties": {"id": {"type": "string", "format": "uuid"}, "workspaceId": {"type": "string", "format": "uuid"}, "templateId": {"type": "string", "format": "uuid"}, "name": {"type": "string"}, "version": {"type": "string"}, "contentDigest": {"$ref": "#/components/schemas/Digest"}, "manifest": {"$ref": "sandbox-template.schema.json"}, "status": {"enum": ["published", "deprecated", "prohibited"]}, "createdAt": {"type": "string", "format": "date-time"}}},
      "SandboxTemplateVersionEnvelope": {"type": "object", "additionalProperties": false, "required": ["template", "version"], "properties": {"template": {"$ref": "#/components/schemas/SandboxTemplate"}, "version": {"$ref": "#/components/schemas/SandboxTemplateVersion"}}},
      "SandboxTemplateVersionList": {"type": "object", "additionalProperties": false, "required": ["items", "nextCursor"], "properties": {"items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/components/schemas/SandboxTemplateVersion"}}, "nextCursor": {"type": ["string", "null"]}}},
      "TemplateReference": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"type": "string", "maxLength": 63}, "version": {"type": "string", "maxLength": 128}}},
      "SandboxSource": {"type": "object", "additionalProperties": false, "required": ["repository", "commit"], "properties": {"repository": {"type": "string", "maxLength": 63}, "commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}}},
      "CreateSandboxRequest": {"type": "object", "additionalProperties": false, "required": ["template", "architecture", "allocationMode", "expiresInSeconds", "sources", "approvedNonSensitive"], "properties": {"template": {"$ref": "#/components/schemas/TemplateReference"}, "architecture": {"enum": ["amd64", "arm64"]}, "allocationMode": {"enum": ["direct", "claim"]}, "expiresInSeconds": {"type": "integer", "minimum": 60, "maximum": 7200}, "sources": {"type": "array", "maxItems": 8, "items": {"$ref": "#/components/schemas/SandboxSource"}}, "approvedNonSensitive": {"const": true}}},
      "SandboxSourceBinding": {"type": "object", "additionalProperties": false, "required": ["repository", "url", "destination", "writable", "commit"], "properties": {"repository": {"type": "string", "maxLength": 63}, "url": {"type": "string", "format": "uri", "pattern": "^https://"}, "destination": {"type": "string", "pattern": "^/workspace/src(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._-]+)+$"}, "writable": {"type": "boolean"}, "commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}}},
      "SandboxArtifactContractEntry": {"type": "object", "additionalProperties": false, "required": ["name", "path", "mediaType", "required"], "properties": {"name": {"type": "string", "maxLength": 63}, "path": {"type": "string", "pattern": "^/workspace/artifacts(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._-]+)+$"}, "mediaType": {"type": "string", "maxLength": 128}, "required": {"type": "boolean"}}},
      "SandboxArtifactContract": {"type": "object", "additionalProperties": false, "required": ["digest", "items"], "properties": {"digest": {"$ref": "#/components/schemas/Digest"}, "items": {"type": "array", "maxItems": 32, "items": {"$ref": "#/components/schemas/SandboxArtifactContractEntry"}}}},
      "Condition": {"type": "object", "additionalProperties": false, "required": ["type", "status", "reason", "observedAt"], "properties": {"type": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]{0,63}$"}, "status": {"enum": ["true", "false", "unknown"]}, "reason": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]{0,63}$"}, "message": {"type": "string", "maxLength": 1024}, "observedAt": {"type": "string", "format": "date-time"}}},
      "Sandbox": {"type": "object", "additionalProperties": false, "required": ["id", "workspaceId", "requestedBy", "templateId", "templateVersionId", "templateName", "templateVersion", "templateDigest", "variantName", "imageIndexDigest", "imageDigest", "architecture", "allocationMode", "sourceBindings", "artifactContract", "state", "desiredState", "version", "queueName", "admissionId", "isolation", "expiresAt", "conditions", "createdAt", "updatedAt"], "properties": {"id": {"type": "string", "format": "uuid"}, "workspaceId": {"type": "string", "format": "uuid"}, "requestedBy": {"type": "string", "format": "uuid"}, "templateId": {"type": "string", "format": "uuid"}, "templateVersionId": {"type": "string", "format": "uuid"}, "templateName": {"type": "string"}, "templateVersion": {"type": "string"}, "templateDigest": {"$ref": "#/components/schemas/Digest"}, "variantName": {"type": "string"}, "imageIndexDigest": {"$ref": "#/components/schemas/ImmutableOCIReference"}, "imageDigest": {"$ref": "#/components/schemas/ImmutableOCIReference"}, "architecture": {"enum": ["amd64", "arm64"]}, "allocationMode": {"enum": ["direct", "claim"]}, "sourceBindings": {"type": "array", "maxItems": 8, "items": {"$ref": "#/components/schemas/SandboxSourceBinding"}}, "artifactContract": {"$ref": "#/components/schemas/SandboxArtifactContract"}, "state": {"enum": ["requested", "queued", "provisioning", "ready", "running", "stopping", "stopped", "deleting", "deleted", "failed"]}, "desiredState": {"enum": ["ready", "stopped", "deleted"]}, "version": {"type": "integer", "minimum": 1}, "queueName": {"type": "string", "minLength": 1}, "admissionId": {"type": ["string", "null"]}, "isolation": {"const": "approved-non-sensitive-poc"}, "expiresAt": {"type": "string", "format": "date-time"}, "conditions": {"type": "array", "maxItems": 32, "items": {"$ref": "#/components/schemas/Condition"}}, "createdAt": {"type": "string", "format": "date-time"}, "updatedAt": {"type": "string", "format": "date-time"}, "stoppedAt": {"type": ["string", "null"], "format": "date-time"}, "deletedAt": {"type": ["string", "null"], "format": "date-time"}}},
      "SandboxList": {"type": "object", "additionalProperties": false, "required": ["items", "nextCursor"], "properties": {"items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/components/schemas/Sandbox"}}, "nextCursor": {"type": ["string", "null"]}}},
      "CreateSandboxOperationRequest": {"type": "object", "additionalProperties": false, "required": ["type", "expectedVersion"], "properties": {"type": {"enum": ["stop", "delete"]}, "expectedVersion": {"type": "integer", "minimum": 1}}, "x-blazn-semantics": {"stop": "revoke every grant, export declared artifacts, destroy the direct or claim backend, then retain the stopped record; success requires all receipt completion flags", "delete": "perform stop semantics first when live, then tombstone the retained record; success requires all receipt completion flags"}},
      "SandboxCleanupResult": {"type": "object", "additionalProperties": false, "required": ["artifactIds", "warnings"], "properties": {"artifactIds": {"type": "array", "maxItems": 32, "items": {"type": "string", "format": "uuid"}}, "warnings": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 1024}}}},
