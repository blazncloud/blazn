{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blazn.benpelo.com/schemas/nodes/v1alpha1/node-install-receipt.json",
  "title": "Blazn NodeInstallReceipt",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "receiptId", "planId", "planDigest", "nodeId", "generation", "state", "currentStage", "owner", "binary", "service", "mutations", "residues", "createdAt", "updatedAt", "signingKeyId", "digest", "signature"],
  "properties": {
    "schemaVersion": {"const": "nodes/v1alpha1"},
    "receiptId": {"type": "string", "format": "uuid"},
    "planId": {"type": "string", "format": "uuid"},
    "planDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nodeId": {"type": "string", "format": "uuid"},
    "generation": {"type": "integer", "minimum": 1},
    "state": {"enum": ["preparing", "installing", "joining", "verifying", "active", "rolling_back", "recovery_required", "removed"]},
    "currentStage": {"enum": ["authenticate", "preflight", "plan", "acquire", "install", "configure", "pre_register", "join", "service", "verify", "activate", "complete"]},
    "owner": {"type": "object", "additionalProperties": false, "required": ["uid", "pid", "processStartIdentity", "nonce"], "properties": {"uid": {"type": "integer", "minimum": 0}, "pid": {"type": "integer", "minimum": 1}, "processStartIdentity": {"type": "string", "minLength": 1}, "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{32,128}$"}}},
    "binary": {"type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": {"path": {"type": "string", "pattern": "^/"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "service": {"type": "object", "additionalProperties": false, "required": ["manager", "name", "definitionDigest", "priorEnabled", "priorActive"], "properties": {"manager": {"enum": ["systemd", "launchd"]}, "name": {"type": "string", "minLength": 1, "maxLength": 256}, "definitionDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "priorEnabled": {"type": "boolean"}, "priorActive": {"type": "boolean"}}},
    "mutations": {
      "type": "array", "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["ordinal", "kind", "target", "priorState", "rollbackMaterial", "desiredDigest", "status"],
        "properties": {
          "ordinal": {"type": "integer", "minimum": 1},
          "kind": {"enum": ["package", "file", "directory", "systemd_unit", "launchd_unit", "certificate", "image", "label", "taint", "firewall"]},
          "target": {"type": "string", "minLength": 1, "maxLength": 1024},
          "priorState": {"enum": ["absent", "owned", "preexisting_exact"]},
          "rollbackMaterial": {"oneOf": [
            {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "absent"}}},
            {"type": "object", "additionalProperties": false, "required": ["kind", "locator", "digest", "mode", "uid", "gid"], "properties": {"kind": {"enum": ["file_backup", "package_snapshot", "unit_snapshot", "firewall_snapshot", "metadata_snapshot"]}, "locator": {"type": "string", "pattern": "^receipt-backup://[A-Za-z0-9._/-]{1,512}$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "mode": {"type": "integer", "minimum": 0, "maximum": 4095}, "uid": {"type": "integer", "minimum": 0}, "gid": {"type": "integer", "minimum": 0}}}
          ]},
          "desiredDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "status": {"enum": ["pending", "applied", "restored", "removed", "residue"]}
        },
        "allOf": [
          {"if": {"properties": {"priorState": {"const": "absent"}}, "required": ["priorState"]}, "then": {"properties": {"rollbackMaterial": {"properties": {"kind": {"const": "absent"}}}}}},
          {"if": {"properties": {"priorState": {"enum": ["owned", "preexisting_exact"]}}, "required": ["priorState"]}, "then": {"properties": {"rollbackMaterial": {"properties": {"kind": {"not": {"const": "absent"}}}}}}}
        ]
      }
    },
    "residues": {"type": "array", "maxItems": 256, "items": {"type": "object", "additionalProperties": false, "required": ["target", "reasonCode", "safeMessage"], "properties": {"target": {"type": "string", "minLength": 1, "maxLength": 1024}, "reasonCode": {"type": "string", "pattern": "^[a-z0-9_]{1,64}$"}, "safeMessage": {"type": "string", "minLength": 1, "maxLength": 512}}}},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "signingKeyId": {"type": "string", "minLength": 1, "maxLength": 128},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
  }
}
