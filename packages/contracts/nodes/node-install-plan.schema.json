{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blazn.benpelo.com/schemas/nodes/v1alpha1/node-install-plan.json",
  "title": "Blazn NodeInstallPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "nodeId", "enrollmentId", "workspaceId", "idempotencyKey", "approvedBy", "approvedAt", "hostname", "mode", "installProfile", "cluster", "target", "registryTrust", "components", "nodeService", "labels", "taints", "resourceBounds", "mutations", "validationTests", "rollback", "issuedAt", "expiresAt", "signingKeyId", "digest", "signature"],
  "properties": {
    "schemaVersion": {"const": "nodes/v1alpha1"},
    "planId": {"type": "string", "format": "uuid"},
    "nodeId": {"type": "string", "format": "uuid"},
    "enrollmentId": {"type": "string", "format": "uuid"},
    "workspaceId": {"type": "string", "format": "uuid"},
    "idempotencyKey": {"type": "string", "minLength": 8, "maxLength": 128},
    "approvedBy": {"type": "string", "format": "uuid"},
    "approvedAt": {"type": "string", "format": "date-time"},
    "hostname": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?$", "maxLength": 253},
    "mode": {"enum": ["fresh", "adopt"]},
    "installProfile": {"enum": ["ubuntu-26.04-amd64-worker/v1", "existing-linux-worker-adopt/v1", "macos-lima-worker-adopt/v1"]},
    "cluster": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "workerOnly", "apiServer", "kubernetesVersion", "joinCredentialEndpoint", "bootstrapTaint", "expectedCaFingerprint", "registryEndpoints"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "workerOnly": {"const": true},
        "apiServer": {"type": "string", "format": "uri", "pattern": "^https://"},
        "kubernetesVersion": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "joinCredentialEndpoint": {"const": "/v1/node-service/join-credentials"},
        "bootstrapTaint": {"const": "blazn.dev/bootstrap=pending:NoSchedule"},
        "expectedCaFingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "registryEndpoints": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "format": "uri", "pattern": "^https://"}}
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["platform", "architecture", "machineFingerprint", "nodePublicKeyFingerprint", "minCpu", "minMemoryBytes", "minDiskBytes"],
      "properties": {
        "platform": {"enum": ["linux", "macos"]},
        "architecture": {"enum": ["amd64", "arm64"]},
        "machineFingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "nodePublicKeyFingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "minCpu": {"type": "integer", "minimum": 1},
        "minMemoryBytes": {"type": "integer", "minimum": 1073741824},
        "minDiskBytes": {"type": "integer", "minimum": 10737418240}
      }
    },
    "registryTrust": {"type": "array", "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["hostname", "caBundleSha256"], "properties": {"hostname": {"type": "string", "format": "hostname"}, "caBundleSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "components": {
      "type": "array", "maxItems": 64,
      "items": {"type": "object", "additionalProperties": false, "required": ["name", "artifactType", "sourceClass", "version", "publisher", "sha256", "ownership"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 128}, "artifactType": {"enum": ["package", "binary", "image", "certificate", "configuration"]}, "sourceClass": {"enum": ["https", "current_binary", "embedded"]}, "version": {"type": "string", "minLength": 1, "maxLength": 128}, "publisher": {"type": "string", "minLength": 1, "maxLength": 256}, "sourceHost": {"type": "string", "format": "hostname"}, "source": {"type": "string", "format": "uri", "pattern": "^https://"}, "repositoryOrigin": {"type": "string", "format": "uri", "pattern": "^https://"}, "registryHost": {"type": "string", "format": "hostname"}, "ociReference": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]+@sha256:[0-9a-f]{64}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "ownership": {"enum": ["install", "adopt_exact"]}}, "allOf": [
        {"if": {"properties": {"sourceClass": {"const": "https"}}, "required": ["sourceClass"]}, "then": {"required": ["sourceHost", "source"]}},
        {"if": {"properties": {"sourceClass": {"enum": ["current_binary", "embedded"]}}, "required": ["sourceClass"]}, "then": {"not": {"anyOf": [{"required": ["sourceHost"]}, {"required": ["source"]}, {"required": ["repositoryOrigin"]}, {"required": ["registryHost"]}, {"required": ["ociReference"]}]}}},
        {"if": {"properties": {"artifactType": {"const": "package"}}, "required": ["artifactType"]}, "then": {"properties": {"sourceClass": {"const": "https"}}, "required": ["repositoryOrigin"], "not": {"anyOf": [{"required": ["registryHost"]}, {"required": ["ociReference"]}]}}},
        {"if": {"properties": {"artifactType": {"const": "image"}}, "required": ["artifactType"]}, "then": {"properties": {"sourceClass": {"const": "https"}}, "required": ["registryHost", "ociReference"], "not": {"required": ["repositoryOrigin"]}}}
      ]}
    },
    "nodeService": {"type": "object", "additionalProperties": false, "required": ["manager", "unitName", "binaryPath", "runAsUser", "runAsGroup", "definitionSha256"], "properties": {"manager": {"enum": ["systemd", "launchd"]}, "unitName": {"type": "string", "minLength": 1, "maxLength": 256}, "binaryPath": {"type": "string", "pattern": "^/"}, "runAsUser": {"type": "string", "minLength": 1, "maxLength": 128}, "runAsGroup": {"type": "string", "minLength": 1, "maxLength": 128}, "definitionSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "labels": {"type": "object", "maxProperties": 64, "propertyNames": {"pattern": "^blazn\\.dev/[a-z0-9][a-z0-9._-]{0,62}$"}, "additionalProperties": {"type": "string", "maxLength": 128}},
    "taints": {"type": "array", "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["key", "value", "effect"], "properties": {"key": {"type": "string", "pattern": "^blazn\\.dev/[a-z0-9][a-z0-9._-]{0,62}$"}, "value": {"type": "string", "maxLength": 128}, "effect": {"enum": ["NoSchedule", "PreferNoSchedule", "NoExecute"]}}}},
    "resourceBounds": {"type": "object", "additionalProperties": false, "required": ["reservedCpuMillis", "reservedMemoryBytes", "maxPods", "maxConcurrentAgents"], "properties": {"reservedCpuMillis": {"type": "integer", "minimum": 0}, "reservedMemoryBytes": {"type": "integer", "minimum": 0}, "maxPods": {"type": "integer", "minimum": 1, "maximum": 4096}, "maxConcurrentAgents": {"type": "integer", "minimum": 1, "maximum": 1024}}},
    "mutations": {
      "type": "array", "maxItems": 256,
      "items": {"type": "object", "additionalProperties": false, "required": ["ordinal", "kind", "action", "target", "desired", "desiredDigest", "mode", "uid", "gid", "rollback"], "properties": {"ordinal": {"type": "integer", "minimum": 1}, "kind": {"enum": ["group", "user", "package", "file", "directory", "systemd_unit", "launchd_unit", "certificate", "image", "label", "taint", "firewall"]}, "action": {"enum": ["install", "write", "create", "enable", "pull", "apply", "adopt_exact"]}, "target": {"type": "string", "minLength": 1, "maxLength": 1024, "not": {"anyOf": [{"const": "/"}, {"pattern": "(?:^|/)\\.\\.(?:/|$)"}]}}, "desired": {"type": "object", "maxProperties": 32}, "desiredDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "mode": {"type": "integer", "minimum": 0, "maximum": 4095}, "uid": {"type": "integer", "minimum": 0}, "gid": {"type": "integer", "minimum": 0}, "rollback": {"enum": ["restore_prior", "remove_if_owned", "leave_and_report"]}}, "allOf": [
        {"if": {"properties": {"kind": {"const": "group"}}, "required": ["kind"]}, "then": {"properties": {"action": {"enum": ["create", "adopt_exact"]}, "target": {"pattern": "^[a-z_][a-z0-9_-]{0,31}$"}, "desired": {"additionalProperties": false, "required": ["name", "system"], "properties": {"name": {"type": "string", "pattern": "^[a-z_][a-z0-9_-]{0,31}$"}, "system": {"const": true}}}}}},
        {"if": {"properties": {"kind": {"const": "user"}}, "required": ["kind"]}, "then": {"properties": {"action": {"enum": ["create", "adopt_exact"]}, "target": {"pattern": "^[a-z_][a-z0-9_-]{0,31}$"}, "desired": {"additionalProperties": false, "required": ["name", "group", "home", "shell", "system"], "properties": {"name": {"type": "string", "pattern": "^[a-z_][a-z0-9_-]{0,31}$"}, "group": {"type": "string", "pattern": "^[a-z_][a-z0-9_-]{0,31}$"}, "home": {"type": "string", "pattern": "^/var/lib/blazn$"}, "shell": {"enum": ["/usr/sbin/nologin", "/sbin/nologin"]}, "system": {"const": true}}}}}},
        {"if": {"properties": {"kind": {"const": "package"}}, "required": ["kind"]}, "then": {"properties": {"action": {"enum": ["install", "adopt_exact"]}, "target": {"pattern": "^[a-z0-9][a-z0-9+.-]{0,127}$"}, "desired": {"additionalProperties": false, "required": ["manager", "version", "componentName"], "properties": {"manager": {"enum": ["apt", "snap", "brew"]}, "version": {"type": "string", "minLength": 1, "maxLength": 128}, "componentName": {"type": "string", "minLength": 1, "maxLength": 128}}}}}},
        {"if": {"properties": {"kind": {"enum": ["file", "certificate"]}}, "required": ["kind"]}, "then": {"properties": {"action": {"enum": ["write", "adopt_exact"]}, "target": {"pattern": "^/(?:usr/local/bin|etc/blazn|var/lib/blazn|Library/Application Support/Blazn)/"}, "desired": {"additionalProperties": false, "required": ["sourceComponent", "contentSha256"], "properties": {"sourceComponent": {"type": "string", "minLength": 1, "maxLength": 128}, "contentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}}},
        {"if": {"properties": {"kind": {"const": "directory"}}, "required": ["kind"]}, "then": {"properties": {"action": {"enum": ["create", "adopt_exact"]}, "target": {"pattern": "^/(?:etc/blazn|var/lib/blazn|opt/blazn)(?:/|$)"}, "desired": {"maxProperties": 0}}}},
        {"if": {"properties": {"kind": {"const": "systemd_unit"}}, "required": ["kind"]}, "then": {"properties": {"action": {"enum": ["write", "enable", "adopt_exact"]}, "target": {"pattern": "^/etc/systemd/system/[A-Za-z0-9_.@-]+\\.service$"}, "desired": {"additionalProperties": false, "required": ["unitName", "sourceComponent"], "properties": {"unitName": {"type": "string", "pattern": "^[A-Za-z0-9_.@-]+\\.service$"}, "sourceComponent": {"type": "string", "minLength": 1, "maxLength": 128}}}}}},
        {"if": {"properties": {"kind": {"const": "launchd_unit"}}, "required": ["kind"]}, "then": {"properties": {"action": {"enum": ["write", "enable", "adopt_exact"]}, "target": {"pattern": "^/Library/LaunchDaemons/[A-Za-z0-9_.-]+\\.plist$"}, "desired": {"additionalProperties": false, "required": ["label", "sourceComponent"], "properties": {"label": {"type": "string", "minLength": 1, "maxLength": 256}, "sourceComponent": {"type": "string", "minLength": 1, "maxLength": 128}}}}}},
        {"if": {"properties": {"kind": {"const": "image"}}, "required": ["kind"]}, "then": {"properties": {"action": {"enum": ["pull", "adopt_exact"]}, "target": {"pattern": "^[A-Za-z0-9._:/-]+@sha256:[0-9a-f]{64}$"}, "desired": {"additionalProperties": false, "required": ["platform", "componentName"], "properties": {"platform": {"enum": ["linux/amd64", "linux/arm64"]}, "componentName": {"type": "string", "minLength": 1, "maxLength": 128}}}}}},
        {"if": {"properties": {"kind": {"const": "label"}}, "required": ["kind"]}, "then": {"properties": {"action": {"const": "apply"}, "target": {"pattern": "^blazn\\.dev/[a-z0-9][a-z0-9._-]{0,62}$"}, "desired": {"additionalProperties": false, "required": ["value"], "properties": {"value": {"type": "string", "maxLength": 128}}}}}},
        {"if": {"properties": {"kind": {"const": "taint"}}, "required": ["kind"]}, "then": {"properties": {"action": {"const": "apply"}, "target": {"pattern": "^blazn\\.dev/[a-z0-9][a-z0-9._-]{0,62}$"}, "desired": {"additionalProperties": false, "required": ["value", "effect"], "properties": {"value": {"type": "string", "maxLength": 128}, "effect": {"enum": ["NoSchedule", "PreferNoSchedule", "NoExecute"]}}}}}},
        {"if": {"properties": {"kind": {"const": "firewall"}}, "required": ["kind"]}, "then": {"properties": {"action": {"const": "apply"}, "target": {"pattern": "^blazn:[a-z0-9_-]{1,64}$"}, "desired": {"additionalProperties": false, "required": ["protocol", "port", "direction"], "properties": {"protocol": {"enum": ["tcp", "udp"]}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}, "direction": {"enum": ["ingress", "egress"]}}}}}}
      ]}
    },
    "validationTests": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"enum": ["binary_digest", "service_account", "service_active", "node_identity", "cluster_ca", "worker_only", "lima_worker_binding", "node_uid_binding", "bootstrap_taint", "capability_heartbeat", "agent_eligibility"]}},
    "rollback": {"type": "object", "additionalProperties": false, "required": ["preserveUserData", "preserveControlPlane", "ambiguousOwnership", "backupRootClass", "backupRoot"], "properties": {"preserveUserData": {"const": true}, "preserveControlPlane": {"const": true}, "ambiguousOwnership": {"const": "recovery_required"}, "backupRootClass": {"enum": ["linux_var_lib", "macos_library_application_support"]}, "backupRoot": {"type": "string", "not": {"pattern": "(?:^|/)\\.\\.(?:/|$)"}}}, "allOf": [
      {"if": {"properties": {"backupRootClass": {"const": "linux_var_lib"}}, "required": ["backupRootClass"]}, "then": {"properties": {"backupRoot": {"pattern": "^/var/lib/blazn/install-backups/[A-Za-z0-9_-]{1,128}$"}}}},
      {"if": {"properties": {"backupRootClass": {"const": "macos_library_application_support"}}, "required": ["backupRootClass"]}, "then": {"properties": {"backupRoot": {"pattern": "^/Library/Application Support/Blazn/install-backups/[A-Za-z0-9_-]{1,128}$"}}}}
    ]},
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "signingKeyId": {"type": "string", "minLength": 1, "maxLength": 128},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
  },
  "allOf": [
    {"if": {"properties": {"mode": {"const": "fresh"}}, "required": ["mode"]}, "then": {"properties": {"components": {"minItems": 1}, "mutations": {"minItems": 1}}}}
  ]
}
