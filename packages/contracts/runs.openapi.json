{
  "openapi": "3.1.0",
  "info": {"title": "Blazn Run and Artifact API", "version": "v1alpha1"},
  "servers": [{"url": "https://blazn.benpelo.com"}],
  "security": [{"bearerAuth": []}],
  "paths": {
    "/v1/workspaces/{workspaceId}/projects/{projectId}/runs": {
      "post": {
        "operationId": "createRun",
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/ProjectId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateRunRequest"}}}},
        "responses": {"202": {"description": "Run accepted", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunEnvelope"}}}}, "default": {"$ref": "#/components/responses/RunError"}}
      },
      "get": {
        "operationId": "listRuns",
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/ProjectId"}, {"$ref": "#/components/parameters/Status"}, {"$ref": "#/components/parameters/Cursor"}],
        "responses": {"200": {"description": "Project Runs", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunList"}}}}, "default": {"$ref": "#/components/responses/RunError"}}
      }
    },
    "/v1/workspaces/{workspaceId}/projects/{projectId}/runs/{runId}": {
      "get": {
        "operationId": "getRun",
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/ProjectId"}, {"$ref": "#/components/parameters/RunId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "responses": {"200": {"description": "Run", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunEnvelope"}}}}, "default": {"$ref": "#/components/responses/RunError"}}
      }
    },
    "/v1/workspaces/{workspaceId}/projects/{projectId}/runs/{runId}/cancel": {
      "post": {
        "operationId": "cancelRun",
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/ProjectId"}, {"$ref": "#/components/parameters/RunId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CancelRunRequest"}}}},
        "responses": {"200": {"description": "Run cancellation recorded", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunEnvelope"}}}}, "default": {"$ref": "#/components/responses/RunError"}}
      }
    },
    "/v1/workspaces/{workspaceId}/projects/{projectId}/runs/{runId}/messages": {
      "get": {
        "operationId": "listRunMessages",
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/ProjectId"}, {"$ref": "#/components/parameters/RunId"}, {"$ref": "#/components/parameters/Cursor"}],
        "responses": {"200": {"description": "Ordered Run messages", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunMessageList"}}}}, "default": {"$ref": "#/components/responses/RunError"}}
      },
      "post": {
        "operationId": "sendRunMessage",
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/ProjectId"}, {"$ref": "#/components/parameters/RunId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SendRunMessageRequest"}}}},
        "responses": {"201": {"description": "Message durably queued for the Run", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunMessageEnvelope"}}}}, "default": {"$ref": "#/components/responses/RunError"}}
      }
    },
    "/v1/workspaces/{workspaceId}/projects/{projectId}/runs/{runId}/messages/claim": {
      "post": {
        "operationId": "claimRunMessage",
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/ProjectId"}, {"$ref": "#/components/parameters/RunId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ClaimRunMessageRequest"}}}},
        "responses": {"200": {"description": "Next message claim or an empty queue", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunMessageClaimEnvelope"}}}}, "default": {"$ref": "#/components/responses/RunError"}}
      }
    },
    "/v1/workspaces/{workspaceId}/projects/{projectId}/runs/{runId}/messages/{messageId}/deliver": {
      "post": {
        "operationId": "deliverRunMessage",
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/ProjectId"}, {"$ref": "#/components/parameters/RunId"}, {"name": "messageId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DeliverRunMessageRequest"}}}},
        "responses": {"200": {"description": "Claimed message marked delivered", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunMessageEnvelope"}}}}, "default": {"$ref": "#/components/responses/RunError"}}
      }
    },
    "/v1/workspaces/{workspaceId}/projects/{projectId}/runs/{runId}/synthetic/progress": {
      "post": {
        "operationId": "recordSyntheticRunProgress",
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/ProjectId"}, {"$ref": "#/components/parameters/RunId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SyntheticRunProgressRequest"}}}},
        "responses": {"200": {"description": "Synthetic progress accepted or replayed", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProgressAck"}}}}, "default": {"$ref": "#/components/responses/RunError"}}
      }
    },
    "/v1/workspaces/{workspaceId}/projects/{projectId}/runs/{runId}/synthetic/complete": {
      "post": {
        "operationId": "completeSyntheticRun",
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/ProjectId"}, {"$ref": "#/components/parameters/RunId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CompleteSyntheticRunRequest"}}}},
        "responses": {"200": {"description": "Synthetic Run completed with an immutable receipt", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunEnvelope"}}}}, "default": {"$ref": "#/components/responses/RunError"}}
      }
    },
    "/v1/workspaces/{workspaceId}/projects/{projectId}/runs/{runId}/artifacts": {
      "post": {
        "operationId": "uploadSyntheticRunArtifact",
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/ProjectId"}, {"$ref": "#/components/parameters/RunId"}, {"$ref": "#/components/parameters/IdempotencyKey"}, {"$ref": "#/components/parameters/ArtifactMetadata"}],
        "requestBody": {"required": true, "content": {"application/octet-stream": {"schema": {"type": "string", "format": "binary", "contentMediaType": "application/octet-stream"}}}, "x-blazn-max-bytes": 1073741824},
        "responses": {"201": {"description": "Digest-verified ready Artifact", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ArtifactEnvelope"}}}}, "default": {"$ref": "#/components/responses/RunError"}}
      }
    },
    "/v1/workspaces/{workspaceId}/projects/{projectId}/artifacts": {
      "get": {
        "operationId": "listArtifacts",
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/ProjectId"}, {"$ref": "#/components/parameters/ArtifactStatus"}, {"$ref": "#/components/parameters/Cursor"}],
        "responses": {"200": {"description": "Project Artifacts", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ArtifactList"}}}}, "default": {"$ref": "#/components/responses/RunError"}}
      }
    },
    "/v1/workspaces/{workspaceId}/projects/{projectId}/artifacts/{artifactId}": {
      "get": {
        "operationId": "getArtifact",
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/ProjectId"}, {"$ref": "#/components/parameters/ArtifactId"}],
        "responses": {"200": {"description": "Artifact metadata", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ArtifactEnvelope"}}}}, "default": {"$ref": "#/components/responses/RunError"}}
      }
    }
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "opaque"}},
    "parameters": {
      "WorkspaceId": {"name": "workspaceId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "ProjectId": {"name": "projectId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "RunId": {"name": "runId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "ArtifactId": {"name": "artifactId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 8, "maxLength": 128}},
      "Status": {"name": "status", "in": "query", "required": false, "schema": {"type": "string", "enum": ["queued", "running", "succeeded", "failed", "cancelled", "all"], "default": "all"}},
      "ArtifactStatus": {"name": "status", "in": "query", "required": false, "schema": {"type": "string", "enum": ["pending", "ready", "failed", "deleted", "all"], "default": "ready"}},
      "Cursor": {"name": "cursor", "in": "query", "required": false, "schema": {"type": "string", "maxLength": 512}}
      ,"ArtifactMetadata": {"name": "X-Blazn-Artifact-Metadata", "in": "header", "required": true, "description": "Unpadded Base64URL canonical JSON matching ArtifactUploadMetadata", "schema": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,8192}$"}, "x-blazn-decoded-schema": {"$ref": "#/components/schemas/ArtifactUploadMetadata"}}
    },
    "responses": {"RunError": {"description": "Documented Run, Artifact, Project, Workspace, or common error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunError"}}}}},
    "schemas": {
      "ProofClass": {"type": "string", "enum": ["synthetic", "local", "sandbox", "provider"]},
      "RunStatus": {"type": "string", "enum": ["queued", "running", "succeeded", "failed", "cancelled"]},
      "RunPlacement": {
        "type": ["object", "null"], "additionalProperties": false,
        "properties": {
          "nodeId": {"type": "string", "format": "uuid"},
          "sandboxId": {"type": "string", "format": "uuid"},
          "modelRouteId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,254}$"}
        }
      },
      "RunReceipt": {
        "type": ["object", "null"], "additionalProperties": false,
        "required": ["schemaVersion", "proofClass", "outcome", "planDigest", "artifactIds", "summary"],
        "properties": {
          "schemaVersion": {"const": "blazn.run/receipt/v1alpha1"},
          "proofClass": {"$ref": "#/components/schemas/ProofClass"},
          "outcome": {"type": "string", "enum": ["succeeded", "failed", "cancelled"]},
          "planDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "artifactIds": {"type": "array", "maxItems": 1000, "items": {"type": "string", "format": "uuid"}},
          "summary": {"type": "object", "additionalProperties": false, "required": ["steps", "warnings"], "properties": {"steps": {"type": "integer", "minimum": 0}, "warnings": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 512}}}}
        }
      },
      "Run": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "workspaceId", "projectId", "kind", "proofClass", "status", "version", "planDigest", "inputArtifactIds", "outputNames", "requestedBy", "placement", "receipt", "createdAt"],
        "properties": {
          "id": {"type": "string", "format": "uuid"}, "workspaceId": {"type": "string", "format": "uuid"}, "projectId": {"type": "string", "format": "uuid"},
          "kind": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,95}$"}, "proofClass": {"$ref": "#/components/schemas/ProofClass"}, "status": {"$ref": "#/components/schemas/RunStatus"},
          "version": {"type": "integer", "minimum": 1}, "planDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "inputArtifactIds": {"type": "array", "maxItems": 1000, "items": {"type": "string", "format": "uuid"}},
          "outputNames": {"type": "array", "maxItems": 1000, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}},
          "requestedBy": {"type": "string", "format": "uuid"}, "placement": {"$ref": "#/components/schemas/RunPlacement"}, "receipt": {"$ref": "#/components/schemas/RunReceipt"},
          "createdAt": {"type": "string", "format": "date-time"}, "startedAt": {"type": "string", "format": "date-time"}, "completedAt": {"type": "string", "format": "date-time"},
          "errorCode": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"}
        },
        "allOf": [
          {"if": {"properties": {"status": {"const": "queued"}}, "required": ["status"]}, "then": {"properties": {"receipt": {"type": "null"}}, "not": {"anyOf": [{"required": ["startedAt"]}, {"required": ["completedAt"]}, {"required": ["errorCode"]}]}}},
          {"if": {"properties": {"status": {"const": "running"}}, "required": ["status"]}, "then": {"required": ["startedAt"], "properties": {"receipt": {"type": "null"}}, "not": {"anyOf": [{"required": ["completedAt"]}, {"required": ["errorCode"]}]}}},
          {"if": {"properties": {"status": {"const": "succeeded"}}, "required": ["status"]}, "then": {"required": ["completedAt"], "properties": {"receipt": {"type": "object"}}, "not": {"required": ["errorCode"]}}},
          {"if": {"properties": {"status": {"const": "failed"}}, "required": ["status"]}, "then": {"required": ["completedAt", "errorCode"], "properties": {"receipt": {"type": "object"}}}},
          {"if": {"properties": {"status": {"const": "cancelled"}}, "required": ["status"]}, "then": {"required": ["completedAt"], "properties": {"receipt": {"type": "object"}}}},
          {"if": {"properties": {"proofClass": {"const": "synthetic"}}, "required": ["proofClass"]}, "then": {"properties": {"placement": {"type": "null"}}}},
          {"if": {"properties": {"proofClass": {"const": "local"}, "status": {"not": {"const": "queued"}}}, "required": ["proofClass", "status"]}, "then": {"properties": {"placement": {"type": "object", "required": ["nodeId"], "not": {"anyOf": [{"required": ["sandboxId"]}, {"required": ["modelRouteId"]}]}}}}},
          {"if": {"properties": {"proofClass": {"const": "sandbox"}, "status": {"not": {"const": "queued"}}}, "required": ["proofClass", "status"]}, "then": {"properties": {"placement": {"type": "object", "required": ["nodeId", "sandboxId"], "not": {"required": ["modelRouteId"]}}}}},
          {"if": {"properties": {"proofClass": {"const": "provider"}, "status": {"not": {"const": "queued"}}}, "required": ["proofClass", "status"]}, "then": {"properties": {"placement": {"type": "object", "required": ["modelRouteId"], "not": {"anyOf": [{"required": ["nodeId"]}, {"required": ["sandboxId"]}]}}}}}
        ]
      },
      "RunEnvelope": {"type": "object", "additionalProperties": false, "required": ["run"], "properties": {"run": {"$ref": "#/components/schemas/Run"}}},
      "RunList": {"type": "object", "additionalProperties": false, "required": ["items", "nextCursor"], "properties": {"items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/components/schemas/Run"}}, "nextCursor": {"type": ["string", "null"], "maxLength": 512}}},
      "CreateRunRequest": {"type": "object", "additionalProperties": false, "required": ["kind", "proofClass", "planDigest", "inputArtifactIds", "outputNames"], "properties": {"kind": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,95}$"}, "proofClass": {"$ref": "#/components/schemas/ProofClass"}, "planDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "inputArtifactIds": {"type": "array", "maxItems": 1000, "items": {"type": "string", "format": "uuid"}}, "outputNames": {"type": "array", "maxItems": 1000, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}}}},
      "CancelRunRequest": {"type": "object", "additionalProperties": false, "required": ["expectedVersion"], "properties": {"expectedVersion": {"type": "integer", "minimum": 1}}},
      "RunMessageKind": {"type": "string", "enum": ["prompt", "followup", "steer"]},
      "RunMessage": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "workspaceId", "projectId", "runId", "ordinal", "role", "kind", "status", "content", "contentDigest", "createdBy", "createdAt"],
        "properties": {
          "id": {"type": "string", "format": "uuid"}, "workspaceId": {"type": "string", "format": "uuid"}, "projectId": {"type": "string", "format": "uuid"}, "runId": {"type": "string", "format": "uuid"},
          "ordinal": {"type": "integer", "minimum": 1}, "role": {"type": "string", "enum": ["user", "assistant", "tool"]}, "kind": {"$ref": "#/components/schemas/RunMessageKind"},
          "status": {"type": "string", "enum": ["queued", "claimed", "delivered"]}, "parentMessageId": {"type": "string", "format": "uuid"},
          "content": {"type": "string", "minLength": 1, "maxLength": 16384}, "contentDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "createdBy": {"type": "string", "format": "uuid"}, "createdAt": {"type": "string", "format": "date-time"}
        }
      },
      "SendRunMessageRequest": {"type": "object", "additionalProperties": false, "required": ["kind", "content"], "properties": {"kind": {"$ref": "#/components/schemas/RunMessageKind"}, "content": {"type": "string", "minLength": 1, "maxLength": 16384}, "parentMessageId": {"type": "string", "format": "uuid"}}},
      "RunMessageEnvelope": {"type": "object", "additionalProperties": false, "required": ["message"], "properties": {"message": {"$ref": "#/components/schemas/RunMessage"}}},
      "RunMessageList": {"type": "object", "additionalProperties": false, "required": ["items", "nextCursor"], "properties": {"items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/components/schemas/RunMessage"}}, "nextCursor": {"type": ["string", "null"], "pattern": "^[1-9][0-9]*$"}}},
      "ClaimRunMessageRequest": {"type": "object", "additionalProperties": false, "required": ["leaseSeconds"], "properties": {"leaseSeconds": {"type": "integer", "minimum": 5, "maximum": 300}}},
      "DeliverRunMessageRequest": {"type": "object", "additionalProperties": false, "required": ["claimId"], "properties": {"claimId": {"type": "string", "format": "uuid"}}},
      "RunMessageClaim": {"type": "object", "additionalProperties": false, "required": ["message", "claimId", "leaseExpiresAt"], "properties": {"message": {"$ref": "#/components/schemas/RunMessage"}, "claimId": {"type": "string", "format": "uuid"}, "leaseExpiresAt": {"type": "string", "format": "date-time"}}},
      "RunMessageClaimEnvelope": {"type": "object", "additionalProperties": false, "required": ["claim"], "properties": {"claim": {"oneOf": [{"$ref": "#/components/schemas/RunMessageClaim"}, {"type": "null"}]}}},
      "SyntheticRunProgressRequest": {"type": "object", "additionalProperties": false, "required": ["sequence", "phase", "percent"], "properties": {"sequence": {"type": "integer", "minimum": 0}, "phase": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,95}$"}, "percent": {"type": "integer", "minimum": 0, "maximum": 100}, "message": {"type": "string", "maxLength": 512}}},
      "ProgressAck": {"type": "object", "additionalProperties": false, "required": ["runId", "sequence", "runVersion", "status"], "properties": {"runId": {"type": "string", "format": "uuid"}, "sequence": {"type": "integer", "minimum": 0}, "runVersion": {"type": "integer", "minimum": 1}, "status": {"const": "running"}}},
      "CompleteSyntheticRunRequest": {"type": "object", "additionalProperties": false, "required": ["expectedVersion", "planDigest", "artifactIds", "summary"], "properties": {"expectedVersion": {"type": "integer", "minimum": 1}, "planDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "artifactIds": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}}, "summary": {"$ref": "#/components/schemas/RunReceiptSummary"}}},
      "RunReceiptSummary": {"type": "object", "additionalProperties": false, "required": ["steps", "warnings"], "properties": {"steps": {"type": "integer", "minimum": 0}, "warnings": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 512}}}},
      "ArtifactMediaType": {"type": "string", "enum": ["image", "video", "audio", "document", "data", "other"]},
      "ArtifactUploadMetadata": {"type": "object", "additionalProperties": false, "required": ["name", "kind", "mediaType", "sizeBytes", "digest"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 256}, "kind": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,95}$"}, "mediaType": {"$ref": "#/components/schemas/ArtifactMediaType"}, "sizeBytes": {"type": "integer", "minimum": 0, "maximum": 1073741824}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
      "Artifact": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "workspaceId", "projectId", "kind", "mediaType", "name", "status", "version", "createdBy", "createdAt", "updatedAt", "downloadAvailable"],
        "properties": {
          "id": {"type": "string", "format": "uuid"}, "workspaceId": {"type": "string", "format": "uuid"}, "projectId": {"type": "string", "format": "uuid"}, "sourceRunId": {"type": "string", "format": "uuid"},
          "kind": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,95}$"}, "mediaType": {"type": "string", "enum": ["image", "video", "audio", "document", "data", "other"]}, "name": {"type": "string", "minLength": 1, "maxLength": 256},
          "status": {"type": "string", "enum": ["pending", "ready", "failed", "deleted"]}, "version": {"type": "integer", "minimum": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "sizeBytes": {"type": "integer", "minimum": 0},
          "createdBy": {"type": "string", "format": "uuid"}, "createdAt": {"type": "string", "format": "date-time"}, "updatedAt": {"type": "string", "format": "date-time"}, "downloadAvailable": {"type": "boolean"}
        },
        "allOf": [
          {"if": {"properties": {"status": {"const": "ready"}}, "required": ["status"]}, "then": {"required": ["digest", "sizeBytes"], "properties": {"downloadAvailable": {"const": true}}}},
          {"if": {"properties": {"status": {"not": {"const": "ready"}}}, "required": ["status"]}, "then": {"properties": {"downloadAvailable": {"const": false}}}}
        ]
      },
      "ArtifactEnvelope": {"type": "object", "additionalProperties": false, "required": ["artifact"], "properties": {"artifact": {"$ref": "#/components/schemas/Artifact"}}},
      "ArtifactList": {"type": "object", "additionalProperties": false, "required": ["items", "nextCursor"], "properties": {"items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/components/schemas/Artifact"}}, "nextCursor": {"type": ["string", "null"], "maxLength": 512}}},
      "RunError": {"type": "object", "additionalProperties": false, "required": ["code", "message", "requestId"], "properties": {"code": {"type": "string", "enum": ["run_not_found", "run_terminal", "run_sequence_conflict", "message_conflict", "message_parent_not_found", "artifact_not_found", "artifact_name_conflict", "artifact_digest_mismatch", "artifact_size_mismatch", "upload_too_large", "project_not_found", "workspace_not_found", "membership_required", "permission_denied", "version_conflict", "idempotency_conflict", "invalid_request", "method_not_allowed", "rate_limited", "access_expired", "session_revoked", "unauthorized", "internal_error"]}, "message": {"type": "string", "minLength": 1, "maxLength": 1024}, "requestId": {"type": "string", "minLength": 1, "maxLength": 128}}, "x-blazn-error-status": {"run_not_found": 404, "run_terminal": 409, "run_sequence_conflict": 409, "message_conflict": 409, "message_parent_not_found": 404, "artifact_not_found": 404, "artifact_name_conflict": 409, "artifact_digest_mismatch": 400, "artifact_size_mismatch": 400, "upload_too_large": 413, "project_not_found": 404, "workspace_not_found": 404, "membership_required": 403, "permission_denied": 403, "version_conflict": 409, "idempotency_conflict": 409, "invalid_request": 400, "method_not_allowed": 405, "rate_limited": 429, "access_expired": 401, "session_revoked": 401, "unauthorized": 401, "internal_error": 500}}
    }
  }
}
