{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blazn.benpelo.com/schemas/v1alpha1/auth-session.schema.json",
  "title": "Blazn device session",
  "type": "object",
	"required": ["apiOrigin", "accessToken", "refreshToken", "expiresAt", "deviceId", "devicePrivateKey"],
  "properties": {
	"apiOrigin": {"type": "string", "format": "uri", "pattern": "^https://[^/]+$"},
	"accessToken": {"type": "string", "minLength": 32, "maxLength": 512},
	"refreshToken": {"type": "string", "minLength": 32, "maxLength": 512},
	"expiresAt": {"type": "string", "format": "date-time"},
	"deviceId": {"type": "string", "minLength": 1, "maxLength": 128},
	"devicePrivateKey": {"type": "string", "description": "Unpadded base64url Ed25519 private key", "pattern": "^[A-Za-z0-9_-]{86}$"}
  },
  "additionalProperties": false
}
