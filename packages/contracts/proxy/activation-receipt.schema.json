{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blazn.benpelo.com/schemas/proxy/v1alpha1/activation-receipt.json",
  "title": "Blazn proxy activation receipt",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "activationId", "nonce", "generation", "ownerUid", "journalDigest", "policyDigest", "platform", "mode", "sessionIdentity", "binary", "listener", "publicationMechanism", "environment", "rollbackSummary", "activatedAt", "state", "checksum"],
  "properties": {
    "schemaVersion": {"const": "proxy/v1alpha1"},
    "activationId": {"type": "string", "format": "uuid"},
    "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{32,128}$"},
    "generation": {"type": "integer", "minimum": 1},
    "ownerUid": {"type": "integer", "minimum": 0},
    "journalDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "policyDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "platform": {"enum": ["darwin", "linux"]},
    "mode": {"enum": ["session", "scoped_run"]},
    "sessionIdentity": {"type": "string", "minLength": 1, "maxLength": 256},
    "binary": {"type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": {"path": {"type": "string", "pattern": "^/"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "listener": {"type": "object", "additionalProperties": false, "required": ["pid", "processStartIdentity", "executableIdentity", "address", "listenerKeyFingerprint"], "properties": {"pid": {"type": "integer", "minimum": 1}, "processStartIdentity": {"type": "string", "minLength": 1}, "executableIdentity": {"type": "string", "minLength": 1}, "address": {"type": "string", "pattern": "^(127\\.0\\.0\\.1|\\[::1\\]):[0-9]{1,5}$"}, "listenerKeyFingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "publicationMechanism": {"enum": ["process_environment", "launchctl_user_environment", "systemd_user_environment"]},
    "environment": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["name", "desiredValueDigest", "activationMarker"], "properties": {"name": {"enum": ["OPENAI_BASE_URL", "OPENAI_API_KEY", "ANTHROPIC_BASE_URL", "ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN"]}, "desiredValueDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "activationMarker": {"type": "string", "minLength": 16}}}, "allOf": [
      {"contains": {"type": "object", "required": ["name"], "properties": {"name": {"const": "OPENAI_BASE_URL"}}}, "minContains": 1, "maxContains": 1},
      {"contains": {"type": "object", "required": ["name"], "properties": {"name": {"const": "OPENAI_API_KEY"}}}, "minContains": 1, "maxContains": 1},
      {"contains": {"type": "object", "required": ["name"], "properties": {"name": {"const": "ANTHROPIC_BASE_URL"}}}, "minContains": 1, "maxContains": 1},
      {"contains": {"type": "object", "required": ["name"], "properties": {"name": {"const": "ANTHROPIC_API_KEY"}}}, "minContains": 1, "maxContains": 1},
      {"contains": {"type": "object", "required": ["name"], "properties": {"name": {"const": "ANTHROPIC_AUTH_TOKEN"}}}, "minContains": 1, "maxContains": 1}
    ]},
    "rollbackSummary": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["ordinal", "operation", "target"], "properties": {"ordinal": {"type": "integer", "minimum": 1}, "operation": {"enum": ["restore_environment", "stop_listener", "remove_scoped_state"]}, "target": {"type": "string", "minLength": 1, "maxLength": 256}}}},
    "activatedAt": {"type": "string", "format": "date-time"},
    "state": {"enum": ["active", "recovery_required"]},
    "checksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
