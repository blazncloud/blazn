{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blazn.dev/schemas/proxy-workload-scope-v1alpha1.json",
  "title": "Blazn Proxy Workload Scope",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "workspaceId", "projectId", "operationId", "sandboxId", "agentVersionId", "agentVersionDigest", "harnessProfileId", "harnessProfileDigest", "harnessVersionId", "harnessVersionDigest", "harnessExecutableDigest", "routeId", "routeVersion", "protocol", "expiresAt", "listenerCredentialRef", "listenerTokenFingerprint"],
  "properties": {
    "runId": {"$ref": "#/$defs/id"},
    "workspaceId": {"$ref": "#/$defs/id"},
    "projectId": {"$ref": "#/$defs/id"},
    "operationId": {"$ref": "#/$defs/id"},
    "sandboxId": {"$ref": "#/$defs/id"},
    "agentVersionId": {"$ref": "#/$defs/id"},
    "agentVersionDigest": {"$ref": "#/$defs/digest"},
    "harnessProfileId": {"$ref": "#/$defs/id"},
    "harnessProfileDigest": {"$ref": "#/$defs/digest"},
    "harnessVersionId": {"$ref": "#/$defs/id"},
    "harnessVersionDigest": {"$ref": "#/$defs/digest"},
    "harnessExecutableDigest": {"$ref": "#/$defs/digest"},
    "routeId": {"$ref": "#/$defs/id"},
    "routeVersion": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "protocol": {"enum": ["openai-responses", "openai-chat", "anthropic-messages"]},
    "expiresAt": {"type": "string", "format": "date-time"},
    "listenerCredentialRef": {"type": "string", "pattern": "^listener-token://[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "listenerTokenFingerprint": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "x-blazn-secret-boundary": {
    "listenerTokenDelivery": "out-of-band",
    "allowedListenerMaterial": ["listenerCredentialRef", "listenerTokenFingerprint"],
    "forbiddenKeys": ["listenerToken", "token", "password", "secret", "credential", "authorization", "apiKey", "privateKey", "kubeconfig", "nodeCredential"]
  }
}
