{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blazn.benpelo.com/schemas/proxy/v1alpha1/normalized-stream-event.json",
  "title": "Normalized proxy stream event",
  "type": "object", "additionalProperties": false,
  "required": ["logicalRequestId", "sequence", "type"],
  "properties": {
    "logicalRequestId": {"type": "string", "format": "uuid"},
    "sequence": {"type": "integer", "minimum": 0},
    "type": {"enum": ["response_start", "text_delta", "tool_call_start", "tool_arguments_delta", "usage", "response_end", "error"]},
    "text": {"type": "string"},
    "callId": {"type": "string", "minLength": 1, "maxLength": 256},
    "toolName": {"type": "string", "minLength": 1, "maxLength": 128},
    "argumentsDelta": {"type": "string"},
    "usage": {"type": "object", "additionalProperties": false, "required": ["inputTokens", "outputTokens"], "properties": {"inputTokens": {"type": "integer", "minimum": 0}, "outputTokens": {"type": "integer", "minimum": 0}}},
    "finishReason": {"enum": ["stop", "length", "tool_call", "content_filter", "cancelled"]},
    "error": {"$ref": "normalized-error.schema.json"}
  },
  "oneOf": [
    {"properties": {"type": {"const": "response_start"}}, "not": {"anyOf": [{"required": ["text"]}, {"required": ["callId"]}, {"required": ["toolName"]}, {"required": ["argumentsDelta"]}, {"required": ["finishReason"]}, {"required": ["error"]}]}},
    {"properties": {"type": {"const": "text_delta"}}, "required": ["text"], "not": {"anyOf": [{"required": ["callId"]}, {"required": ["toolName"]}, {"required": ["argumentsDelta"]}, {"required": ["usage"]}, {"required": ["finishReason"]}, {"required": ["error"]}]}},
    {"properties": {"type": {"const": "tool_call_start"}}, "required": ["callId", "toolName"], "not": {"anyOf": [{"required": ["text"]}, {"required": ["argumentsDelta"]}, {"required": ["usage"]}, {"required": ["finishReason"]}, {"required": ["error"]}]}},
    {"properties": {"type": {"const": "tool_arguments_delta"}}, "required": ["callId", "argumentsDelta"], "not": {"anyOf": [{"required": ["text"]}, {"required": ["toolName"]}, {"required": ["usage"]}, {"required": ["finishReason"]}, {"required": ["error"]}]}},
    {"properties": {"type": {"const": "usage"}}, "required": ["usage"], "not": {"anyOf": [{"required": ["text"]}, {"required": ["callId"]}, {"required": ["toolName"]}, {"required": ["argumentsDelta"]}, {"required": ["finishReason"]}, {"required": ["error"]}]}},
    {"properties": {"type": {"const": "response_end"}}, "required": ["finishReason"], "not": {"anyOf": [{"required": ["text"]}, {"required": ["callId"]}, {"required": ["toolName"]}, {"required": ["argumentsDelta"]}, {"required": ["usage"]}, {"required": ["error"]}]}},
    {"properties": {"type": {"const": "error"}}, "required": ["error"], "not": {"anyOf": [{"required": ["text"]}, {"required": ["callId"]}, {"required": ["toolName"]}, {"required": ["argumentsDelta"]}, {"required": ["usage"]}, {"required": ["finishReason"]}]}}
  ]
}
