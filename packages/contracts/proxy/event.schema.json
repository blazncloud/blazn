{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blazn.benpelo.com/schemas/proxy/v1alpha1/event.json",
  "title": "Blazn proxy operational event",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "cursor", "timestamp", "type", "activationId", "logicalRequestId", "attempt", "protocol", "modelAlias", "policy", "routeId", "destinationClass", "outcome", "reasonCode", "latencyMs"],
  "properties": {
    "eventId": {"type": "string", "format": "uuid"},
    "cursor": {"type": "string", "minLength": 1, "maxLength": 128},
    "timestamp": {"type": "string", "format": "date-time"},
    "type": {"enum": ["request_started", "route_selected", "attempt_finished", "request_finished", "request_cancelled"]},
    "activationId": {"type": "string", "format": "uuid"},
    "logicalRequestId": {"type": "string", "format": "uuid"},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 2},
    "protocol": {"enum": ["openai-responses", "openai-chat", "anthropic-messages"]},
    "modelAlias": {"type": "string", "minLength": 1, "maxLength": 128},
    "policy": {"type": "object", "additionalProperties": false, "required": ["id", "version", "digest"], "properties": {"id": {"type": "string", "format": "uuid"}, "version": {"type": "integer", "minimum": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "routeId": {"type": "string", "format": "uuid"},
    "destinationClass": {"enum": ["local_node", "company", "provider", "blazn_cloud"]},
    "outcome": {"enum": ["success", "failed", "cancelled", "fallback"]},
    "reasonCode": {"enum": ["none", "connection_failure", "timeout_before_first_byte", "rate_limited", "upstream_5xx", "model_unavailable", "compatible_context_overflow", "unsupported_capability", "authentication_failed", "policy_denied", "cancelled", "fallback_selected"]},
    "latencyMs": {"type": "integer", "minimum": 0},
    "usage": {"type": "object", "additionalProperties": false, "required": ["inputTokens", "outputTokens"], "properties": {"inputTokens": {"type": "integer", "minimum": 0}, "outputTokens": {"type": "integer", "minimum": 0}}}
  },
  "oneOf": [
    {"properties": {"type": {"const": "request_started"}, "outcome": {"const": "success"}, "reasonCode": {"const": "none"}}, "not": {"required": ["usage"]}},
    {"properties": {"type": {"const": "route_selected"}, "outcome": {"const": "success"}, "reasonCode": {"const": "none"}}, "not": {"required": ["usage"]}},
    {"properties": {"type": {"const": "route_selected"}, "outcome": {"const": "fallback"}, "reasonCode": {"const": "fallback_selected"}}, "not": {"required": ["usage"]}},
    {"properties": {"type": {"const": "attempt_finished"}, "outcome": {"const": "success"}, "reasonCode": {"const": "none"}}},
    {"properties": {"type": {"const": "attempt_finished"}, "outcome": {"const": "failed"}, "reasonCode": {"enum": ["connection_failure", "timeout_before_first_byte", "rate_limited", "upstream_5xx", "model_unavailable", "compatible_context_overflow", "unsupported_capability", "authentication_failed", "policy_denied"]}}},
    {"properties": {"type": {"const": "request_finished"}, "outcome": {"const": "success"}, "reasonCode": {"const": "none"}}},
    {"properties": {"type": {"const": "request_finished"}, "outcome": {"const": "failed"}, "reasonCode": {"enum": ["connection_failure", "timeout_before_first_byte", "rate_limited", "upstream_5xx", "model_unavailable", "compatible_context_overflow", "unsupported_capability", "authentication_failed", "policy_denied"]}}},
    {"properties": {"type": {"const": "request_cancelled"}, "outcome": {"const": "cancelled"}, "reasonCode": {"const": "cancelled"}}, "not": {"required": ["usage"]}}
  ]
}
