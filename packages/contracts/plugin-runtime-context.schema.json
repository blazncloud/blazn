{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blazn.benpelo.com/contracts/plugin-runtime-context-v1.schema.json",
  "title": "Blazn plugin runtime context v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocolVersion", "invocationId", "coreVersion", "outputFormat", "status"],
  "properties": {
    "schemaVersion": {"const": 1},
    "protocolVersion": {"const": 1},
    "invocationId": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "coreVersion": {"type": "string", "minLength": 1, "maxLength": 128},
    "outputFormat": {"enum": ["human", "json", "jsonl", "csv"]},
    "status": {"enum": ["selected", "unselected", "unavailable"]},
    "reasonCode": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"},
    "apiOrigin": {"type": "string", "format": "uri", "maxLength": 2048},
    "userId": {"type": "string", "minLength": 1, "maxLength": 255},
    "workspaceId": {"type": "string", "minLength": 1, "maxLength": 255},
    "projectId": {"type": "string", "minLength": 1, "maxLength": 255}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "selected"}}, "required": ["status"]},
      "then": {"required": ["apiOrigin", "userId", "workspaceId"], "not": {"required": ["reasonCode"]}}
    },
    {
      "if": {"properties": {"status": {"enum": ["unselected", "unavailable"]}}, "required": ["status"]},
      "then": {"required": ["reasonCode"], "not": {"anyOf": [{"required": ["userId"]}, {"required": ["workspaceId"]}, {"required": ["projectId"]}]}}
    }
  ]
}
