# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

FROM --platform=$BUILDPLATFORM golang:1.26.2-bookworm@sha256:47ce5636e9936b2c5cbf708925578ef386b4f8872aec74a67bd13a627d242b19 AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/blazn-harness-worker ./cmd/blazn-harness-worker
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build \
      -buildvcs=false -trimpath -tags netgo,osusergo -ldflags='-s -w' \
      -o /out/blazn-harness-worker ./cmd/blazn-harness-worker && \
    mkdir -p /rootfs/opt/blazn /rootfs/workspace/artifacts && \
    chmod 0555 /rootfs/opt /rootfs/opt/blazn && \
    chown -R 65532:65532 /rootfs/workspace && \
    chmod 0750 /rootfs/workspace /rootfs/workspace/artifacts

# This is deliberately a worker-only foundation. An approved derived image
# must add a root-owned, mode-0555 /opt/blazn/hermes whose SHA-256 is bound in
# the workload scope. Building this file does not qualify a Hermes runtime.
FROM scratch
LABEL org.opencontainers.image.title="Blazn harness worker foundation" \
      dev.blazn.image.kind="harness-worker-foundation" \
      dev.blazn.hermes.included="false" \
      dev.blazn.hermes.runnable="false"
COPY --from=build /rootfs/ /
COPY --from=build --chmod=0555 /out/blazn-harness-worker /opt/blazn/blazn-harness-worker
USER 65532:65532
WORKDIR /workspace
ENTRYPOINT ["/opt/blazn/blazn-harness-worker", "--", "/opt/blazn/hermes", "run", "--jsonl"]
