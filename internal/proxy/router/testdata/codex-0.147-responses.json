{
  "model": "company-assistant",
  "instructions": "Work carefully and return a structured result.",
  "input": [
    {
      "type": "reasoning",
      "id": "rs_01",
      "summary": [{"type": "summary_text", "text": "Prior turn summary"}],
      "encrypted_content": "opaque-reasoning-state"
    },
    {
      "type": "message",
      "role": "user",
      "content": [{"type": "input_text", "text": "Inspect the repository"}]
    },
    {
      "type": "function_call",
      "call_id": "call_01",
      "name": "read_file",
      "arguments": "{\"path\":\"README.md\"}"
    },
    {
      "type": "function_call_output",
      "call_id": "call_01",
      "output": "README contents"
    }
  ],
  "tools": [
    {
      "type": "function",
      "name": "read_file",
      "description": "Read a repository file",
      "parameters": {
        "type": "object",
        "properties": {"path": {"type": "string"}},
        "required": ["path"],
        "additionalProperties": false
      }
    }
  ],
  "tool_choice": "auto",
  "parallel_tool_calls": true,
  "store": false,
  "include": ["reasoning.encrypted_content"],
  "reasoning": {"effort": "medium", "summary": "auto"},
  "stream": true,
  "stream_options": {"include_obfuscation": false},
  "service_tier": "auto",
  "prompt_cache_key": "codex-session-01",
  "client_metadata": {"harness": "codex", "version": "0.147.0"},
  "text": {
    "format": {
      "type": "json_schema",
      "name": "repository_result",
      "schema": {
        "type": "object",
        "properties": {"summary": {"type": "string"}},
        "required": ["summary"],
        "additionalProperties": false
      },
      "strict": true
    }
  },
  "max_output_tokens": 1024
}
