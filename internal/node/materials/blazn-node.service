[Unit]
Description=Blazn Node Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=blazn-node
Group=blazn-node
ExecStart=/usr/local/bin/blazn node serve
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/blazn

[Install]
WantedBy=multi-user.target
