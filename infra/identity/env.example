BLAZN_IDENTITY_DATA_ROOT=/var/lib/blazn/identity
BLAZN_IDENTITY_SECRETS_ROOT=/etc/blazn/identity/secrets
BLAZN_IDENTITY_BIND_ADDRESS=127.0.0.1
ZITADEL_DOMAIN=auth.example.invalid
ZITADEL_PROXY_PORT=58081
ZITADEL_LOGIN_CLIENT_PAT_EXPIRATION=2027-08-22T00:00:00Z
ZITADEL_PROVIDER_GATE_PAT_EXPIRATION=2027-08-22T00:00:00Z

# Every value is intentionally invalid until replaced with an independently
# reviewed repository@sha256 digest. Tags are rejected by validate-environment.
ZITADEL_POSTGRES_IMAGE=REPLACE_POSTGRES_REPOSITORY@sha256:REPLACE_64_HEX
ZITADEL_TRAEFIK_IMAGE=REPLACE_TRAEFIK_REPOSITORY@sha256:REPLACE_64_HEX
ZITADEL_IMAGE=REPLACE_ZITADEL_REPOSITORY@sha256:REPLACE_64_HEX
ZITADEL_LOGIN_IMAGE=REPLACE_ZITADEL_LOGIN_REPOSITORY@sha256:REPLACE_64_HEX
ZITADEL_BACKUP_IMAGE=REPLACE_BACKUP_REPOSITORY@sha256:REPLACE_64_HEX

# Disposable qualification only. The driver itself is separately reviewed,
# installed root-owned/single-link/mode-0500, and pinned here by exact digest.
ZITADEL_QUALIFICATION_DRIVER_SHA256=sha256:REPLACE_WITH_REVIEWED_DRIVER_64_HEX
