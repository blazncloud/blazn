BLAZN_IDENTITY_DATA_ROOT=/var/lib/blazn/identity
BLAZN_IDENTITY_SECRETS_ROOT=/etc/blazn/identity/secrets
BLAZN_IDENTITY_BIND_ADDRESS=127.0.0.1
ZITADEL_DOMAIN=auth.example.invalid
ZITADEL_PROXY_PORT=58081
ZITADEL_LOGIN_CLIENT_PAT_EXPIRATION=2027-08-22T00:00:00Z

# Replace tags with reviewed immutable image digests before deployment.
ZITADEL_POSTGRES_IMAGE=postgres:17.10-alpine
ZITADEL_TRAEFIK_IMAGE=traefik:v3.7.7
ZITADEL_IMAGE=ghcr.io/zitadel/zitadel:v4.17.1
ZITADEL_LOGIN_IMAGE=ghcr.io/zitadel/zitadel-login:v4.17.1
