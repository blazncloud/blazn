{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blazn.dev/schemas/node-platform-qualification-inventory-v1.json",
  "title": "Blazn node platform qualification invariant inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "phase", "correlationId", "observedAt", "source", "protected", "target"],
  "properties": {
    "schemaVersion": {"const": 1},
    "phase": {"enum": ["before", "after"]},
    "correlationId": {"type": "string", "pattern": "^nodequal-[a-z0-9][a-z0-9.-]{6,63}$"},
    "observedAt": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "tree"],
      "properties": {
        "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "protected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["units", "containers"],
      "properties": {
        "units": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "containers": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      }
    },
    "target": {"type": "object"}
  }
}
