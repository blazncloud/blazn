{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blazn.dev/schemas/poc/node-broker-receipt-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "secretsRoot", "databaseRole", "keyIds", "digests", "creationJournal"],
  "properties": {
    "schemaVersion": { "const": "blazn.dev/node-broker-infra/v1" },
    "secretsRoot": { "const": "/etc/blazn/node-broker/secrets" },
    "databaseRole": { "const": "blazn_node_broker" },
    "keyIds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enrollment", "joinCredential"],
      "properties": {
        "enrollment": { "const": "node-enrollment/v1" },
        "joinCredential": { "const": "node-join-credential/v1" }
      }
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database-url", "enrollment-hmac-v1", "join-credential-v1"],
      "properties": {
        "database-url": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "enrollment-hmac-v1": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "join-credential-v1": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "creationJournal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "enum": ["/var/lib/blazn/ownership/node-broker-secret-create.json", "/var/lib/blazn/ownership/node-broker-upgrade-secret-create.json"] },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}
