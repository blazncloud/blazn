{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blazn.dev/schemas/poc/control-plane-backup-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "correlationId", "fencingToken", "createdAt", "database", "bucket", "nodeBrokerReceiptDigest"],
  "properties": {
    "schemaVersion": { "const": "blazn.dev/control-plane-backup/v1" },
    "correlationId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "fencingToken": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z$" },
    "database": { "const": "blazn" },
    "bucket": { "type": "string", "minLength": 1 },
    "nodeBrokerReceiptDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
