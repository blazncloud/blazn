[Unit]
Description=Blazn POC control plane
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/blazn/control-plane/control-plane.env

[Service]
Type=simple
EnvironmentFile=/etc/blazn/control-plane/control-plane.env
Environment=DOCKER_CONFIG=/etc/blazn/docker-cli
Environment=COMPOSE_BAKE=false
WorkingDirectory=/opt/blazn/infra/milestone-2
ExecStartPre=/opt/blazn/infra/milestone-2/scripts/preflight.sh --deploy
ExecStart=/opt/blazn/infra/milestone-2/scripts/run-control-plane.sh
ExecStopPost=/usr/bin/docker compose --env-file /etc/blazn/control-plane/control-plane.env stop
Restart=on-failure
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=120
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/srv/frontro/blazn-poc /var/lib/blazn /etc/blazn/docker-cli

[Install]
WantedBy=multi-user.target
