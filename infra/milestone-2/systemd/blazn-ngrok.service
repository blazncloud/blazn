[Unit]
Description=Blazn POC ngrok tunnel (API only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/blazn/infra/milestone-2/scripts/with-public-origin-lock.sh permanent /usr/local/bin/ngrok http 127.0.0.1:58080 --url https://blazn.benpelo.com --config %h/.config/ngrok/homeai.yml --inspect=false --log stdout --log-format json
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-/run/lock/blazn-poc

[Install]
WantedBy=multi-user.target
