[Unit]
Description=Blazn POC ngrok tunnel (API only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/ngrok http 127.0.0.1:58080 --url https://blazn.benpelo.com --config %h/.config/ngrok/homeai.yml --inspect=false --log stdout --log-format json
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
