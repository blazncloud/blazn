[Unit]
Description=Blazn POC temporary ngrok qualification tunnel (API only)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/blazn/ngrok/ngrok.yml
ConditionPathExists=/etc/blazn/control-plane/secrets/proxy-auth-secret

[Service]
Type=simple
ExecStartPre=/opt/blazn/infra/milestone-2/scripts/install-ngrok-user.sh --validate-only
ExecStartPre=/opt/blazn/infra/milestone-2/scripts/prepare-ngrok-policy.sh
ExecStart=/opt/blazn/infra/milestone-2/scripts/with-public-origin-lock.sh qualification /usr/bin/setpriv --reuid=blazn-ngrok --regid=blazn-ngrok --init-groups /usr/local/bin/ngrok http 127.0.0.1:58080 --config /etc/blazn/ngrok/ngrok.yml --traffic-policy-file /run/blazn-ngrok/traffic-policy.yml --inspect=false --log stdout --log-format json
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
RuntimeDirectory=blazn-ngrok
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
ReadWritePaths=-/run/lock/blazn-poc -/run/blazn-ngrok
