{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blazn.dev/schemas/poc/workspace-secret-upgrade-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "owner", "host", "secretsRoot", "createdAt", "secretDigest", "releaseDigest", "fencingToken", "correlationId"],
  "properties": {
    "schemaVersion": { "const": "blazn.dev/workspace-secret-upgrade/v1" },
    "owner": { "const": "blazn-poc" },
    "host": { "type": "string", "minLength": 1 },
    "secretsRoot": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "secretDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "releaseDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "fencingToken": { "type": "integer", "minimum": 1 },
    "correlationId": { "type": "string", "minLength": 1 }
  }
}
