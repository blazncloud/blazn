BLAZN_IDENTITY_SECRETS_ROOT=/etc/blazn/identity/secrets
ZITADEL_ISSUER_URL=https://auth.example.invalid
ZITADEL_CLIENT_ID=REPLACE_WITH_BLAZN_ZITADEL_WEB_CLIENT_ID
ZITADEL_REQUIRE_MFA=true
