apiVersion: v1
kind: Namespace
metadata:
  name: agent-sandbox-system
  labels:
    app.kubernetes.io/part-of: blazn-phase4c
    pod-security.kubernetes.io/enforce: restricted
    pod-security.kubernetes.io/enforce-version: latest
    pod-security.kubernetes.io/audit: restricted
    pod-security.kubernetes.io/warn: restricted
---
apiVersion: v1
kind: Namespace
metadata:
  name: blazn-poc
  labels:
    app.kubernetes.io/part-of: blazn-phase4c
    blazn.dev/agent-sandbox-boundary: "true"
    pod-security.kubernetes.io/enforce: restricted
    pod-security.kubernetes.io/enforce-version: latest
    pod-security.kubernetes.io/audit: restricted
    pod-security.kubernetes.io/warn: restricted
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: blazn-sandbox-runner
  namespace: blazn-poc
  labels:
    app.kubernetes.io/part-of: blazn-phase4c
automountServiceAccountToken: false
---
apiVersion: kueue.x-k8s.io/BLAZN_LOCAL_QUEUE_API_VERSION
kind: LocalQueue
metadata:
  name: blazn-poc
  namespace: blazn-poc
  labels:
    app.kubernetes.io/part-of: blazn-phase4c
spec:
  clusterQueue: BLAZN_EXISTING_CLUSTER_QUEUE
