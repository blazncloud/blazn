apiVersion: v1
kind: Namespace
metadata:
  name: blazn-poc
  labels:
    app.kubernetes.io/part-of: blazn-phase4c
    blazn.dev/agent-sandbox-boundary: "true"
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: blazn-sandbox-runner
  namespace: blazn-poc
  labels:
    app.kubernetes.io/part-of: blazn-phase4c
automountServiceAccountToken: false
---
apiVersion: kueue.x-k8s.io/v1beta2
kind: LocalQueue
metadata:
  name: blazn-poc
  namespace: blazn-poc
  labels:
    app.kubernetes.io/part-of: blazn-phase4c
spec:
  clusterQueue: BLAZN_EXISTING_CLUSTER_QUEUE
