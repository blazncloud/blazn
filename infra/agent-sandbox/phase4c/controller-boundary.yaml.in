apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: blazn-agent-sandbox-observer
  labels:
    app.kubernetes.io/part-of: blazn-phase4c
rules:
- apiGroups: [""]
  resources: ["persistentvolumeclaims", "pods", "services"]
  verbs: ["get", "list", "watch"]
- apiGroups: ["agents.x-k8s.io"]
  resources: ["sandboxes"]
  verbs: ["get", "list", "watch"]
- apiGroups: ["apiextensions.k8s.io"]
  resources: ["customresourcedefinitions"]
  resourceNames:
  - sandboxclaims.extensions.agents.x-k8s.io
  - sandboxes.agents.x-k8s.io
  - sandboxtemplates.extensions.agents.x-k8s.io
  - sandboxwarmpools.extensions.agents.x-k8s.io
  verbs: ["get", "patch", "update"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: blazn-agent-sandbox-observer
  labels:
    app.kubernetes.io/part-of: blazn-phase4c
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: blazn-agent-sandbox-observer
subjects:
- kind: ServiceAccount
  name: agent-sandbox-controller
  namespace: agent-sandbox-system
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: blazn-agent-sandbox-system
  namespace: agent-sandbox-system
  labels:
    app.kubernetes.io/part-of: blazn-phase4c
rules:
- apiGroups: [""]
  resources: ["secrets"]
  verbs: ["create"]
- apiGroups: [""]
  resources: ["secrets"]
  resourceNames: ["agent-sandbox-webhook-certs"]
  verbs: ["get", "patch", "update"]
- apiGroups: ["coordination.k8s.io"]
  resources: ["leases"]
  verbs: ["create", "get", "list", "patch", "update", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: blazn-agent-sandbox-system
  namespace: agent-sandbox-system
  labels:
    app.kubernetes.io/part-of: blazn-phase4c
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: blazn-agent-sandbox-system
subjects:
- kind: ServiceAccount
  name: agent-sandbox-controller
  namespace: agent-sandbox-system
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: blazn-agent-sandbox-controller
  namespace: blazn-poc
  labels:
    app.kubernetes.io/part-of: blazn-phase4c
rules:
- apiGroups: [""]
  resources: ["persistentvolumeclaims", "pods", "services"]
  verbs: ["create", "delete", "get", "list", "patch", "update", "watch"]
- apiGroups: ["", "events.k8s.io"]
  resources: ["events"]
  verbs: ["create", "patch"]
- apiGroups: ["agents.x-k8s.io"]
  resources: ["sandboxes"]
  verbs: ["create", "delete", "get", "list", "patch", "update", "watch"]
- apiGroups: ["agents.x-k8s.io"]
  resources: ["sandboxes/finalizers", "sandboxes/status"]
  verbs: ["get", "patch", "update"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: blazn-agent-sandbox-controller
  namespace: blazn-poc
  labels:
    app.kubernetes.io/part-of: blazn-phase4c
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: blazn-agent-sandbox-controller
subjects:
- kind: ServiceAccount
  name: agent-sandbox-controller
  namespace: agent-sandbox-system
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata:
  name: blazn-agent-sandbox-boundary
  labels:
    app.kubernetes.io/part-of: blazn-phase4c
spec:
  failurePolicy: Fail
  matchConstraints:
    resourceRules:
    - apiGroups: ["agents.x-k8s.io"]
      apiVersions: ["v1beta1"]
      operations: ["CREATE", "UPDATE"]
      resources: ["sandboxes"]
      scope: Namespaced
  validations:
  - expression: "object.metadata.namespace == 'blazn-poc'"
    message: "Phase 4C permits Sandbox objects only in blazn-poc"
  - expression: "has(object.spec.podTemplate.metadata.labels) && object.spec.podTemplate.metadata.labels['kueue.x-k8s.io/queue-name'] == 'blazn-poc'"
    message: "Sandbox podTemplate must target the blazn-poc LocalQueue"
  - expression: "object.spec.shutdownPolicy == 'Delete'"
    message: "Phase 4C Sandbox shutdownPolicy must be Delete"
  - expression: "object.spec.podTemplate.spec.serviceAccountName == 'blazn-sandbox-runner' && object.spec.podTemplate.spec.automountServiceAccountToken == false"
    message: "Sandbox Pods must use the tokenless blazn-sandbox-runner identity"
  - expression: "object.spec.podTemplate.spec.nodeSelector['blazn.dev/sandbox-eligible'] == 'true'"
    message: "Sandbox Pods must target reviewed sandbox-eligible nodes"
  - expression: "(!has(object.spec.podTemplate.spec.hostNetwork) || object.spec.podTemplate.spec.hostNetwork == false) && (!has(object.spec.podTemplate.spec.hostPID) || object.spec.podTemplate.spec.hostPID == false) && (!has(object.spec.podTemplate.spec.hostIPC) || object.spec.podTemplate.spec.hostIPC == false)"
    message: "Sandbox Pods may not share host namespaces"
  - expression: "(!has(object.spec.podTemplate.spec.volumes) || size(object.spec.podTemplate.spec.volumes) == 0) && (!has(object.spec.podTemplate.spec.initContainers) || size(object.spec.podTemplate.spec.initContainers) == 0)"
    message: "The Phase 4C canary may not inject volumes or init containers"
  - expression: "object.spec.podTemplate.spec.securityContext.runAsNonRoot == true && object.spec.podTemplate.spec.securityContext.runAsUser == 65532 && object.spec.podTemplate.spec.securityContext.runAsGroup == 65532 && object.spec.podTemplate.spec.securityContext.fsGroup == 65532 && object.spec.podTemplate.spec.securityContext.seccompProfile.type == 'RuntimeDefault'"
    message: "Sandbox Pods must use the reviewed non-root pod security context"
  - expression: "size(object.spec.podTemplate.spec.containers) > 0 && object.spec.podTemplate.spec.containers.all(c, c.image.matches('^.+@sha256:[0-9a-f]{64}$') && (!has(c.env) || size(c.env) == 0) && (!has(c.envFrom) || size(c.envFrom) == 0) && (!has(c.volumeMounts) || size(c.volumeMounts) == 0) && c.securityContext.allowPrivilegeEscalation == false && c.securityContext.readOnlyRootFilesystem == true && (!has(c.securityContext.privileged) || c.securityContext.privileged == false) && c.securityContext.capabilities.drop.exists(x, x == 'ALL'))"
    message: "Every Sandbox container must use a pinned image and the reviewed restricted security context"
  - expression: "BLAZN_RUNTIME_ADMISSION_EXPRESSION"
    message: "Sandbox runtime selection must equal the capability reviewed for this change"
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicyBinding
metadata:
  name: blazn-agent-sandbox-boundary
  labels:
    app.kubernetes.io/part-of: blazn-phase4c
spec:
  policyName: blazn-agent-sandbox-boundary
  validationActions: [Deny]
