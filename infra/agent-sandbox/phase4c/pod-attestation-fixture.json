{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "phase4c-canary",
    "namespace": "blazn-poc",
    "uid": "99999999-9999-4999-8999-999999999999",
    "ownerReferences": [{
      "apiVersion": "agents.x-k8s.io/v1beta1",
      "kind": "Sandbox",
